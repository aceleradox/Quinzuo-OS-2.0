{
  "format": "qnz",
  "version": 1,
  "title": "Pomodoro — Quinzuo Produtividade",
  "name": "Pomodoro — Quinzuo Produtividade",
  "icon": "⏱️",
  "description": "Timer Pomodoro 25/5 minutos com anel de progresso, pausa, som e contador de ciclos.",
  "theme": {
    "primary": "#8b5cf6",
    "cyan": "#06b6d4",
    "background": "#0f172a",
    "dockStyle": "glass"
  },
  "window": {
    "width": 480,
    "height": 560,
    "resizable": true
  },
  "html": "\n<div class=\"qz-wrap\">\n  <header class=\"qz-head\"><div style=\"display:flex;gap:9px;align-items:center\"><span class=\"qz-ico\">⏱️</span><div><b>Pomodoro Quinzuo</b><small>ciclos de foco 25 min / pausa 5 min</small></div></div><span class=\"qz-chip\" id=\"cycles\">0 ciclos</span></header>\n  <div class=\"qz-main\">\n    <div class=\"qz-ring\" id=\"ring\"><div class=\"qz-ring-inner\"><div id=\"time\">25:00</div><small id=\"mode\">FOCO</small></div></div>\n    <div class=\"qz-modes\"><button class=\"qz-btn qz-btn-primary\" data-sec=\"1500\" data-label=\"FOCO\">▶ Foco 25 min</button><button class=\"qz-btn qz-btn-cyan\" data-sec=\"300\" data-label=\"PAUSA\">☕ Pausa 5 min</button></div>\n    <div class=\"qz-controls\"><button id=\"toggle\" class=\"qz-btn\">⏸ Iniciar / Pausar</button><button id=\"reset\" class=\"qz-btn\">↻ Reiniciar</button></div>\n    <div class=\"qz-status\" id=\"status\">Pronto para focar.</div>\n  </div>\n  <div class=\"qz-log\" id=\"log\">// log do Pomodoro</div>\n</div>",
  "css": "\n.qz-wrap{font-family:ui-sans-serif,system-ui,sans-serif;color:#e2e8f0}\n.qz-head{display:flex;justify-content:space-between;align-items:center;padding:9px 13px;border-bottom:1px solid rgba(139,92,246,.28);background:rgba(139,92,246,.08);border-radius:12px 12px 0 0}\n.qz-head b{font-size:14px}.qz-head small{display:block;font-size:10px;color:#94a3b8}\n.qz-ico{font-size:23px}.qz-chip{font-size:10px;color:#22d3ee;border:1px solid rgba(6,182,212,.4);border-radius:99px;padding:3px 8px}\n.qz-btn{cursor:pointer;border:1px solid rgba(148,163,184,.3);background:#111c33;color:#e2e8f0;padding:8px 12px;border-radius:9px;font-size:12px;font-weight:600}\n.qz-btn:hover{border-color:#8b5cf6;transform:translateY(-1px)}\n.qz-btn-primary{background:linear-gradient(135deg,#7c3aed,#a855f7);border-color:transparent}\n.qz-btn-cyan{background:linear-gradient(135deg,#0891b2,#22d3ee);border-color:transparent;color:#04121b}\n.qz-log{font:10px/1.5 ui-monospace,monospace;color:#64748b;margin:0 13px 11px;border-top:1px solid rgba(148,163,184,.12);padding-top:7px;max-height:52px;overflow:auto;white-space:pre-wrap}\n.qz-main{padding:14px;display:flex;flex-direction:column;align-items:center;gap:12px}\n.qz-ring{width:230px;height:230px;border-radius:50%;background:conic-gradient(#8b5cf6 100%,#22d3ee 0);display:flex;align-items:center;justify-content:center;box-shadow:0 0 34px rgba(139,92,246,.25)}\n.qz-ring-inner{width:198px;height:198px;border-radius:50%;background:#0b1223;border:1px solid rgba(148,163,184,.18);display:flex;flex-direction:column;align-items:center;justify-content:center}\n.qz-ring-inner #time{font:700 48px/1 ui-monospace,monospace;color:#f8fafc}\n.qz-ring-inner small{margin-top:9px;font-size:10px;letter-spacing:2px;color:#22d3ee}\n.qz-modes,.qz-controls{display:flex;gap:9px;flex-wrap:wrap;justify-content:center}\n.qz-status{font-size:11px;color:#a78bfa}",
  "js": "\n(function () {\n  var NL = String.fromCharCode(10);\n  var $ = function (id) { return document.getElementById(id); };\n  var total = 1500, remaining = 1500, endAt = 0, tick = null, running = false, cycles = 0, label = 'FOCO';\n  function log(m) { $('log').textContent += '[' + new Date().toLocaleTimeString('pt-BR') + '] ' + m + NL; console.log('[pomodoro] ' + m); }\n  function fmt(s) { var m = Math.floor(s / 60), r = s % 60; return (m < 10 ? '0' : '') + m + ':' + (r < 10 ? '0' : '') + r; }\n  function paint() {\n    $('time').textContent = fmt(remaining);\n    $('mode').textContent = label;\n    var pct = total ? (remaining / total) * 100 : 0;\n    var color = label === 'FOCO' ? '#8b5cf6' : '#06b6d4';\n    $('ring').style.background = 'conic-gradient(' + color + ' ' + pct + '%, rgba(148,163,184,.12) ' + pct + '%)';\n  }\n  function beep() {\n    try {\n      var AC = window.AudioContext || window.webkitAudioContext, ac = new AC();\n      var o = ac.createOscillator(), g = ac.createGain();\n      o.type = 'sine'; o.frequency.value = 880;\n      g.gain.setValueAtTime(0.18, ac.currentTime);\n      g.gain.exponentialRampToValueAtTime(0.001, ac.currentTime + 0.5);\n      o.connect(g); g.connect(ac.destination); o.start(); o.stop(ac.currentTime + 0.5);\n    } catch (e) { log('Som indisponível: ' + e.message); }\n  }\n  function complete() {\n    clearInterval(tick); tick = null; running = false; remaining = 0; paint(); beep();\n    if (label === 'FOCO') { cycles++; $('cycles').textContent = cycles + ' ciclos'; $('status').textContent = 'Foco concluído! Hora da pausa.'; }\n    else $('status').textContent = 'Pausa concluída! Bora focar.';\n    log(label + ' concluído' + (label === 'FOCO' ? ' · ciclo ' + cycles : ''));\n  }\n  function loop() {\n    remaining = Math.max(0, Math.ceil((endAt - Date.now()) / 1000));\n    paint();\n    if (remaining <= 0) complete();\n  }\n  function toggle() {\n    if (running) {\n      running = false; clearInterval(tick); tick = null;\n      remaining = Math.max(0, Math.ceil((endAt - Date.now()) / 1000));\n      $('status').textContent = 'Pausado em ' + fmt(remaining);\n      log('Timer pausado');\n    } else {\n      if (remaining <= 0) remaining = total;\n      endAt = Date.now() + remaining * 1000;\n      running = true; tick = setInterval(loop, 250);\n      $('status').textContent = 'Contando... ' + fmt(remaining);\n      log(label + ' iniciado · ' + fmt(remaining));\n    }\n    paint();\n  }\n  function setMode(sec, lbl) {\n    if (tick) clearInterval(tick);\n    tick = null; running = false; total = sec; remaining = sec; label = lbl;\n    $('status').textContent = lbl === 'FOCO' ? 'Pronto para focar.' : 'Pronto para descansar.';\n    paint(); log('Modo ' + lbl + ' · ' + fmt(sec));\n  }\n  Array.prototype.forEach.call(document.querySelectorAll('.qz-modes button'), function (b) {\n    b.onclick = function () { setMode(parseInt(b.getAttribute('data-sec'), 10), b.getAttribute('data-label')); };\n  });\n  $('toggle').onclick = toggle;\n  $('reset').onclick = function () { setMode(total, label); };\n  paint();\n})();"
}
