{
  "format": "qnz",
  "version": 1,
  "title": "Calculadora — Quinzuo Produtividade",
  "name": "Calculadora — Quinzuo Produtividade",
  "icon": "🧮",
  "description": "Calculadora com parser recursivo seguro, teclado, histórico e operações básicas.",
  "theme": {
    "primary": "#8b5cf6",
    "cyan": "#06b6d4",
    "background": "#0f172a",
    "dockStyle": "glass"
  },
  "window": {
    "width": 400,
    "height": 580,
    "resizable": true
  },
  "html": "\n<div class=\"qz-wrap\">\n  <header class=\"qz-head\"><div style=\"display:flex;gap:9px;align-items:center\"><span class=\"qz-ico\">🧮</span><div><b>Calculadora Quinzuo</b><small>parser seguro · sem eval</small></div></div></header>\n  <div class=\"qz-main\">\n    <div class=\"qz-display\"><div id=\"expr\">&nbsp;</div><div id=\"display\">0</div></div>\n    <div class=\"qz-keys\" id=\"keys\">\n      <button data-val=\"C\" class=\"qz-key qz-key-fn\">C</button><button data-val=\"⌫\" class=\"qz-key qz-key-fn\">⌫</button><button data-val=\"(\" class=\"qz-key qz-key-fn\">(</button><button data-val=\")\" class=\"qz-key qz-key-fn\">)</button>\n      <button data-val=\"7\">7</button><button data-val=\"8\">8</button><button data-val=\"9\">9</button><button data-val=\"/\" class=\"qz-key qz-key-op\">÷</button>\n      <button data-val=\"4\">4</button><button data-val=\"5\">5</button><button data-val=\"6\">6</button><button data-val=\"*\" class=\"qz-key qz-key-op\">×</button>\n      <button data-val=\"1\">1</button><button data-val=\"2\">2</button><button data-val=\"3\">3</button><button data-val=\"-\" class=\"qz-key qz-key-op\">−</button>\n      <button data-val=\"0\">0</button><button data-val=\".\">.</button><button data-val=\"%\" class=\"qz-key qz-key-op\">%</button><button data-val=\"+\" class=\"qz-key qz-key-op\">+</button>\n      <button data-val=\"=\" class=\"qz-key qz-key-eq\">=</button>\n    </div>\n    <div class=\"qz-history\"><b>Histórico</b><div id=\"list\">// vazio</div></div>\n  </div>\n  <div class=\"qz-log\" id=\"log\">// log da calculadora</div>\n</div>",
  "css": "\n.qz-wrap{font-family:ui-sans-serif,system-ui,sans-serif;color:#e2e8f0}\n.qz-head{display:flex;justify-content:space-between;align-items:center;padding:9px 13px;border-bottom:1px solid rgba(139,92,246,.28);background:rgba(139,92,246,.08);border-radius:12px 12px 0 0}\n.qz-head b{font-size:14px}.qz-head small{display:block;font-size:10px;color:#94a3b8}\n.qz-ico{font-size:23px}.qz-chip{font-size:10px;color:#22d3ee;border:1px solid rgba(6,182,212,.4);border-radius:99px;padding:3px 8px}\n.qz-btn{cursor:pointer;border:1px solid rgba(148,163,184,.3);background:#111c33;color:#e2e8f0;padding:8px 12px;border-radius:9px;font-size:12px;font-weight:600}\n.qz-btn:hover{border-color:#8b5cf6;transform:translateY(-1px)}\n.qz-btn-primary{background:linear-gradient(135deg,#7c3aed,#a855f7);border-color:transparent}\n.qz-btn-cyan{background:linear-gradient(135deg,#0891b2,#22d3ee);border-color:transparent;color:#04121b}\n.qz-log{font:10px/1.5 ui-monospace,monospace;color:#64748b;margin:0 13px 11px;border-top:1px solid rgba(148,163,184,.12);padding-top:7px;max-height:52px;overflow:auto;white-space:pre-wrap}\n.qz-main{padding:12px;display:flex;flex-direction:column;gap:10px;align-items:center}\n.qz-display{width:100%;background:#080e1d;border:1px solid rgba(139,92,246,.35);border-radius:11px;padding:10px 13px;text-align:right}\n.qz-display #expr{font:11px ui-monospace,monospace;color:#64748b;min-height:15px}\n.qz-display #display{font:700 30px ui-monospace,monospace;color:#22d3ee;word-break:break-all}\n.qz-keys{display:grid;grid-template-columns:repeat(4,58px);gap:7px}\n.qz-key{cursor:pointer;height:48px;border-radius:10px;border:1px solid rgba(148,163,184,.2);background:#111c33;color:#e2e8f0;font:600 17px ui-monospace,monospace}\n.qz-key:hover{border-color:#8b5cf6;background:#1a2542}\n.qz-key-fn{color:#a78bfa;font-size:14px}.qz-key-op{color:#67e8f9}.qz-key-eq{grid-column:span 4;background:linear-gradient(135deg,#7c3aed,#0891b2);border-color:transparent;color:#fff}\n.qz-history{width:100%;font-size:10px;color:#94a3b8;background:rgba(15,23,42,.7);border:1px solid rgba(148,163,184,.14);border-radius:10px;padding:8px 10px;max-height:74px;overflow:auto}\n.qz-history b{color:#a78bfa;letter-spacing:1px}",
  "js": "\n(function () {\n  var NL = String.fromCharCode(10);\n  var $ = function (id) { return document.getElementById(id); };\n  var expr = '', history = [];\n  function log(m) { $('log').textContent += '[' + new Date().toLocaleTimeString('pt-BR') + '] ' + m + NL; console.log('[calc] ' + m); }\n  function parser(text) {\n    var s = String(text).replace(/ /g, ''), i = 0;\n    function factor() {\n      if (s.charAt(i) === '+') { i++; return factor(); }\n      if (s.charAt(i) === '-') { i++; return -factor(); }\n      if (s.charAt(i) === '(') {\n        i++; var v = sum();\n        if (s.charAt(i) !== ')') throw new Error('parêntese não fechado');\n        i++; return v;\n      }\n      var start = i;\n      while (i < s.length && ((s.charCodeAt(i) >= 48 && s.charCodeAt(i) <= 57) || s.charAt(i) === '.')) i++;\n      if (start === i) throw new Error('número esperado');\n      var n = parseFloat(s.slice(start, i));\n      if (isNaN(n)) throw new Error('número inválido');\n      return n;\n    }\n    function product() {\n      var v = factor();\n      while (s.charAt(i) === '*' || s.charAt(i) === '/' || s.charAt(i) === '%') {\n        var op = s.charAt(i++), r = factor();\n        if (op === '*') v *= r;\n        else if (op === '%') v = r === 0 ? 0 : v % r;\n        else { if (r === 0) throw new Error('divisão por zero'); v /= r; }\n      }\n      return v;\n    }\n    function sum() {\n      var v = product();\n      while (s.charAt(i) === '+' || s.charAt(i) === '-') {\n        var op = s.charAt(i++), r = product();\n        v = op === '+' ? v + r : v - r;\n      }\n      return v;\n    }\n    var result = sum();\n    if (i < s.length) throw new Error('sintaxe inválida');\n    if (!isFinite(result)) throw new Error('resultado infinito');\n    return Math.round(result * 10000000000) / 10000000000;\n  }\n  function show(v) { $('display').textContent = v; }\n  function press(v) {\n    if (v === 'C') { expr = ''; show('0'); $('expr').innerHTML = '&nbsp;'; return; }\n    if (v === '⌫') { expr = expr.slice(0, -1); show(expr || '0'); return; }\n    if (v === '=') {\n      if (!expr) return;\n      try {\n        var r = parser(expr), line = expr + ' = ' + r;\n        history.unshift(line); history = history.slice(0, 12);\n        $('list').textContent = history.join(NL);\n        $('expr').textContent = expr; show(r); log(line);\n        expr = String(r);\n      } catch (e) {\n        show('Erro: ' + e.message); log('Erro: ' + e.message); expr = '';\n      }\n      return;\n    }\n    expr += v; $('expr').textContent = expr; show(expr);\n  }\n  Array.prototype.forEach.call(document.querySelectorAll('.qz-key'), function (b) {\n    b.onclick = function () { press(b.getAttribute('data-val')); };\n  });\n  window.addEventListener('keydown', function (e) {\n    var k = e.key;\n    if (k >= '0' && k <= '9') press(k);\n    else if (k === '+' || k === '-' || k === '*' || k === '/' || k === '.' || k === '%' || k === '(' || k === ')') press(k);\n    else if (k === 'Enter' || k === '=') press('=');\n    else if (k === 'Backspace') press('⌫');\n    else if (k === 'Escape' || k.toLowerCase() === 'c') press('C');\n  });\n  log('Calculadora pronta · parser sem eval');\n})();"
}
