{
  "format": "qnz",
  "version": 1,
  "title": "Notas — Quinzuo Produtividade",
  "name": "Notas — Quinzuo Produtividade",
  "icon": "📝",
  "description": "Bloco de notas com autosave em localStorage, contador e exportação .txt.",
  "theme": {
    "primary": "#8b5cf6",
    "cyan": "#06b6d4",
    "background": "#0f172a",
    "dockStyle": "glass"
  },
  "window": {
    "width": 620,
    "height": 560,
    "resizable": true
  },
  "html": "\n<div class=\"qz-wrap\">\n  <header class=\"qz-head\"><div style=\"display:flex;gap:9px;align-items:center\"><span class=\"qz-ico\">📝</span><div><b>Notas Quinzuo</b><small>autosave local · armazenamento do iframe</small></div></div><span class=\"qz-chip\" id=\"saved\">salvo</span></header>\n  <div class=\"qz-main\">\n    <input id=\"title\" class=\"qz-title\" placeholder=\"Título da nota\" spellcheck=\"false\">\n    <textarea id=\"body\" placeholder=\"Escreva sua nota aqui...\"></textarea>\n    <div class=\"qz-toolbar\"><span id=\"count\">0 caracteres · 0 palavras</span><span id=\"updated\">—</span>\n      <div class=\"qz-spacer\"></div>\n      <button id=\"download\" class=\"qz-btn\">💾 Baixar .txt</button>\n      <button id=\"clear\" class=\"qz-btn\">🗑️ Limpar</button>\n    </div>\n  </div>\n  <div class=\"qz-log\" id=\"log\">// log das notas</div>\n</div>",
  "css": "\n.qz-wrap{font-family:ui-sans-serif,system-ui,sans-serif;color:#e2e8f0}\n.qz-head{display:flex;justify-content:space-between;align-items:center;padding:9px 13px;border-bottom:1px solid rgba(139,92,246,.28);background:rgba(139,92,246,.08);border-radius:12px 12px 0 0}\n.qz-head b{font-size:14px}.qz-head small{display:block;font-size:10px;color:#94a3b8}\n.qz-ico{font-size:23px}.qz-chip{font-size:10px;color:#22d3ee;border:1px solid rgba(6,182,212,.4);border-radius:99px;padding:3px 8px}\n.qz-btn{cursor:pointer;border:1px solid rgba(148,163,184,.3);background:#111c33;color:#e2e8f0;padding:8px 12px;border-radius:9px;font-size:12px;font-weight:600}\n.qz-btn:hover{border-color:#8b5cf6;transform:translateY(-1px)}\n.qz-btn-primary{background:linear-gradient(135deg,#7c3aed,#a855f7);border-color:transparent}\n.qz-btn-cyan{background:linear-gradient(135deg,#0891b2,#22d3ee);border-color:transparent;color:#04121b}\n.qz-log{font:10px/1.5 ui-monospace,monospace;color:#64748b;margin:0 13px 11px;border-top:1px solid rgba(148,163,184,.12);padding-top:7px;max-height:52px;overflow:auto;white-space:pre-wrap}\n.qz-main{padding:12px;display:flex;flex-direction:column;gap:9px;flex:1}\n.qz-title{background:#080e1d;color:#f8fafc;border:1px solid rgba(139,92,246,.4);border-radius:10px;padding:9px 11px;font-size:15px;font-weight:700;outline:none}\n.qz-title:focus,.qz-note:focus{border-color:#22d3ee;box-shadow:0 0 0 2px rgba(6,182,212,.1)}\n.qz-note{flex:1;min-height:260px;resize:none;background:#080e1d;color:#e2e8f0;border:1px solid rgba(148,163,184,.18);border-radius:10px;padding:11px;font:13px/1.6 ui-monospace,monospace;outline:none}\n.qz-toolbar{display:flex;gap:9px;align-items:center;flex-wrap:wrap;font-size:10px;color:#94a3b8}\n.qz-spacer{flex:1}",
  "js": "\n(function () {\n  var NL = String.fromCharCode(10);\n  var $ = function (id) { return document.getElementById(id); };\n  var KEY = 'qz_notes_v1', memoryStore = {}, timer = null;\n  function log(m) { $('log').textContent += '[' + new Date().toLocaleTimeString('pt-BR') + '] ' + m + NL; console.log('[notes] ' + m); }\n  function read() {\n    try { var raw = localStorage.getItem(KEY); return raw ? JSON.parse(raw) : memoryStore; } catch (e) { return memoryStore; }\n  }\n  function write(obj) {\n    memoryStore = obj;\n    try { localStorage.setItem(KEY, JSON.stringify(obj)); return true; } catch (e) { return false; }\n  }\n  function count() {\n    var body = $('body').value;\n    var words = body.trim() ? body.trim().split(' ').filter(function (w) { return !!w; }).length : 0;\n    $('count').textContent = body.length + ' caracteres · ' + words + ' palavras';\n  }\n  function save() {\n    var obj = { title: $('title').value, body: $('body').value, updated: Date.now() };\n    var ok = write(obj);\n    $('saved').textContent = ok ? '✔ salvo localmente' : '⚠ salvo na memória';\n    $('updated').textContent = 'atualizado ' + new Date().toLocaleTimeString('pt-BR');\n    count();\n    log('Autosave · ' + obj.body.length + ' caracteres (' + (ok ? 'localStorage' : 'memória') + ')');\n  }\n  function schedule() {\n    $('saved').textContent = 'salvando...';\n    if (timer) clearTimeout(timer);\n    timer = setTimeout(save, 400);\n  }\n  function load() {\n    var obj = read() || {};\n    $('title').value = obj.title || '';\n    $('body').value = obj.body || '';\n    $('updated').textContent = obj.updated ? 'atualizado ' + new Date(obj.updated).toLocaleString('pt-BR') : '—';\n    count();\n    log('Nota carregada · ' + (obj.body || '').length + ' caracteres');\n  }\n  $('title').addEventListener('input', schedule);\n  $('body').addEventListener('input', schedule);\n  $('clear').onclick = function () {\n    if (!window.confirm('Apagar o título e o texto desta nota?')) return;\n    $('title').value = ''; $('body').value = ''; save(); log('Nota limpa');\n  };\n  $('download').onclick = function () {\n    var text = $('title').value + NL + NL + $('body').value;\n    var blob = new Blob([text], { type: 'text/plain;charset=utf-8' });\n    var url = URL.createObjectURL(blob), a = document.createElement('a');\n    a.href = url; a.download = ($('title').value || 'nota-quinzuo').slice(0, 40) + '.txt';\n    document.body.appendChild(a);\n    try { a.click(); log('Download da nota iniciado'); } catch (e) { log('Download bloqueado: ' + e.message); }\n    document.body.removeChild(a);\n    setTimeout(function () { URL.revokeObjectURL(url); }, 2000);\n  };\n  load();\n})();"
}
