{
  "format": "qnz",
  "version": 1,
  "title": "Quinzeta DB — Mini Banco de Dados",
  "name": "Quinzeta DB — Mini Banco de Dados",
  "icon": "🗄️",
  "description": "Mini-banco com tabelas e campos configuráveis, CRUD de registros, busca, persistência local e exportação JSON.",
  "theme": {
    "primary": "#8b5cf6",
    "cyan": "#06b6d4",
    "background": "#0f172a",
    "dockStyle": "glass"
  },
  "window": {
    "width": 900,
    "height": 640,
    "resizable": true
  },
  "html": "\n<div class=\"qz-wrap\">\n  <header class=\"qz-head\"><div class=\"qz-brand\"><span class=\"qz-ico\">🗄️</span><div><b>Quinzeta DB</b><small>mini-banco de dados · tabelas, campos, registros</small></div></div><span class=\"qz-chip\" id=\"dbState\">localStorage</span></header>\n  <div class=\"qz-main\">\n    <aside class=\"qz-side\">\n      <div class=\"qz-block\"><div class=\"qz-title\">TABELAS</div><select id=\"tables\"></select><div class=\"qz-inline\"><input id=\"newTable\" placeholder=\"Nova tabela\" spellcheck=\"false\"><button id=\"addTable\" class=\"qz-btn qz-btn-primary\">+</button></div></div>\n      <div class=\"qz-block\"><div class=\"qz-title\">CAMPOS</div><div id=\"fields\" class=\"qz-fields\"></div><div class=\"qz-inline\"><input id=\"fieldName\" placeholder=\"Nome do campo\" spellcheck=\"false\"><select id=\"fieldType\"><option value=\"text\">texto</option><option value=\"number\">número</option><option value=\"date\">data</option></select></div><button id=\"addField\" class=\"qz-btn\">➕ Adicionar campo</button></div>\n      <div class=\"qz-block\"><div class=\"qz-title\">AÇÕES</div><button id=\"save\" class=\"qz-btn\">💾 Salvar</button><button id=\"export\" class=\"qz-btn qz-btn-cyan\">⬇ Exportar JSON</button></div>\n    </aside>\n    <section class=\"qz-content\">\n      <div class=\"qz-block\"><div class=\"qz-title\">REGISTROS · <span id=\"count\">0 registros</span></div><div class=\"qz-inline\"><input id=\"search\" placeholder=\"🔎 Buscar em todos os campos...\" spellcheck=\"false\"><button id=\"clearSearch\" class=\"qz-btn\">Limpar</button></div><div id=\"records\" class=\"qz-records\"></div></div>\n      <div class=\"qz-block\"><div class=\"qz-title\" id=\"formTitle\">Novo registro</div><form id=\"form\"><div id=\"formFields\" class=\"qz-form\"></div><div class=\"qz-inline\"><button id=\"submit\" class=\"qz-btn qz-btn-primary\">➕ Adicionar</button><button id=\"cancel\" type=\"button\" class=\"qz-btn\">Cancelar edição</button></div></form></div>\n    </section>\n  </div>\n  <div class=\"qz-log\" id=\"log\">// log do Quinzeta DB</div>\n</div>",
  "css": "\n.qz-wrap{font-family:ui-sans-serif,system-ui,sans-serif;color:#e2e8f0}\n.qz-head{display:flex;justify-content:space-between;align-items:center;padding:9px 13px;border-bottom:1px solid rgba(139,92,246,.3);background:rgba(139,92,246,.09);border-radius:12px 12px 0 0}\n.qz-brand{display:flex;align-items:center;gap:9px}.qz-brand b{font-size:14px}.qz-brand small{font-size:10px;color:#94a3b8;display:block}\n.qz-ico{font-size:23px}.qz-chip{font-size:10px;color:#22d3ee;border:1px solid rgba(6,182,212,.4);border-radius:99px;padding:3px 9px}\n.qz-main{display:grid;grid-template-columns:230px 1fr;gap:11px;padding:12px;flex:1;min-height:0}\n.qz-side,.qz-content{display:flex;flex-direction:column;gap:10px;min-width:0}\n.qz-block{background:rgba(15,23,42,.72);border:1px solid rgba(148,163,184,.16);border-radius:11px;padding:9px;display:flex;flex-direction:column;gap:7px}\n.qz-title{font-size:9px;letter-spacing:1.4px;color:#a78bfa;text-transform:uppercase}\n.qz-inline{display:flex;gap:6px;flex-wrap:wrap;align-items:center}\n.qz-inline input{flex:1;min-width:90px;background:#080e1d;color:#e2e8f0;border:1px solid rgba(148,163,184,.22);border-radius:7px;padding:6px 8px;font-size:11px;outline:none}\n.qz-inline input:focus,.qz-block select:focus{border-color:#8b5cf6}\n.qz-block select{background:#080e1d;color:#e2e8f0;border:1px solid rgba(148,163,184,.22);border-radius:7px;padding:6px;font-size:11px;max-width:100%}\n.qz-btn{cursor:pointer;border:1px solid rgba(148,163,184,.3);background:#111c33;color:#e2e8f0;padding:6px 9px;border-radius:7px;font-size:11px;font-weight:600}\n.qz-btn:hover{border-color:#8b5cf6;transform:translateY(-1px)}\n.qz-btn-primary{background:linear-gradient(135deg,#7c3aed,#a855f7);border-color:transparent}\n.qz-btn-cyan{background:linear-gradient(135deg,#0891b2,#22d3ee);border-color:transparent;color:#04121b}\n.qz-fields{display:flex;flex-wrap:wrap;gap:5px}\n.qz-chip-field{font-size:10px;color:#cbd5e1;background:rgba(139,92,246,.13);border:1px solid rgba(139,92,246,.3);border-radius:99px;padding:3px 4px 3px 8px}\n.qz-chip-field button{cursor:pointer;background:transparent;border:0;color:#fca5a5;font-size:12px}\n.qz-records{max-height:200px;overflow:auto;border:1px solid rgba(148,163,184,.14);border-radius:8px;background:#080e1d}\n.qz-table{border-collapse:collapse;width:100%;font-size:11px}\n.qz-table th,.qz-table td{border-bottom:1px solid rgba(148,163,184,.12);padding:6px 7px;text-align:left;white-space:nowrap}\n.qz-table th{color:#67e8f9;font-size:10px;position:sticky;top:0;background:#0b1223}\n.qz-table td button{cursor:pointer;background:rgba(139,92,246,.16);border:1px solid rgba(139,92,246,.3);color:#e2e8f0;border-radius:5px;margin-right:3px;padding:2px 5px;font-size:10px}\n.qz-empty{padding:10px;color:#64748b;font-size:11px}\n.qz-form{display:flex;flex-wrap:wrap;gap:7px}\n.qz-form label{display:flex;flex-direction:column;gap:3px;font-size:10px;color:#94a3b8;flex:1;min-width:110px}\n.qz-form input{background:#080e1d;color:#e2e8f0;border:1px solid rgba(148,163,184,.22);border-radius:7px;padding:6px;font-size:11px;outline:none}\n.qz-log{font:10px/1.5 ui-monospace,monospace;color:#64748b;margin:0 13px 11px;border-top:1px solid rgba(148,163,184,.12);padding-top:7px;max-height:52px;overflow:auto;white-space:pre-wrap}\n@media(max-width:680px){.qz-main{grid-template-columns:1fr}}",
  "js": "\n(function () {\n  var NL = String.fromCharCode(10);\n  var $ = function (id) { return document.getElementById(id); };\n  var KEY = 'qz_quinzeta_db_v1', db = null, nextId = 1, editingId = null;\n  function log(m) { $('log').textContent += '[' + new Date().toLocaleTimeString('pt-BR') + '] ' + m + NL; console.log('[quinzeta-db] ' + m); }\n  function defaults() {\n    return {\n      active: 0,\n      tables: [{\n        name: 'Contatos',\n        fields: [{ name: 'Nome', type: 'text' }, { name: 'Email', type: 'text' }, { name: 'Idade', type: 'number' }],\n        rows: [\n          { id: 1, values: { Nome: 'Ana', Email: 'ana@example.com', Idade: '28' } },\n          { id: 2, values: { Nome: 'Bruno', Email: 'bruno@example.com', Idade: '35' } }\n        ]\n      }]\n    };\n  }\n  function recalcNext() {\n    nextId = 1;\n    db.tables.forEach(function (t) { t.rows.forEach(function (r) { if (r.id >= nextId) nextId = r.id + 1; }); });\n  }\n  function load() {\n    try {\n      var raw = localStorage.getItem(KEY);\n      if (raw) db = JSON.parse(raw);\n    } catch (e) { log('localStorage indisponivel: ' + e.message); }\n    if (!db || !db.tables || !db.tables.length) db = defaults();\n    recalcNext();\n  }\n  function persist() {\n    try { localStorage.setItem(KEY, JSON.stringify(db)); $('dbState').textContent = 'salvo localmente'; return true; }\n    catch (e) { $('dbState').textContent = 'memoria'; log('Nao persistiu: ' + e.message); return false; }\n  }\n  function table() { return db.tables[db.active] || db.tables[0]; }\n  function renderTables() {\n    var sel = $('tables'); sel.innerHTML = '';\n    db.tables.forEach(function (t, i) { var o = document.createElement('option'); o.value = i; o.textContent = t.name; sel.appendChild(o); });\n    sel.value = db.active;\n  }\n  function renderFields() {\n    var box = $('fields'); box.innerHTML = '';\n    table().fields.forEach(function (f, i) {\n      var chip = document.createElement('span'), b = document.createElement('button');\n      chip.className = 'qz-chip-field'; chip.textContent = f.name + ' (' + f.type + ') ';\n      b.textContent = '×'; b.title = 'Remover campo';\n      b.onclick = function () { removeField(i); };\n      chip.appendChild(b); box.appendChild(chip);\n    });\n  }\n  function renderRecords() {\n    var q = $('search').value.trim().toLowerCase();\n    var rows = table().rows.filter(function (row) {\n      if (!q) return true;\n      return table().fields.some(function (f) { return String(row.values[f.name] || '').toLowerCase().indexOf(q) >= 0; });\n    });\n    var wrap = $('records'); wrap.innerHTML = '';\n    var t = document.createElement('table'), thead = document.createElement('thead'), hr = document.createElement('tr');\n    ['#'].concat(table().fields.map(function (f) { return f.name; })).concat(['Acoes']).forEach(function (h) {\n      var th = document.createElement('th'); th.textContent = h; hr.appendChild(th);\n    });\n    thead.appendChild(hr); t.appendChild(thead);\n    var tbody = document.createElement('tbody');\n    rows.forEach(function (row) {\n      var tr = document.createElement('tr'), idCell = document.createElement('td');\n      idCell.textContent = row.id; tr.appendChild(idCell);\n      table().fields.forEach(function (f) {\n        var td = document.createElement('td'); td.textContent = row.values[f.name] || '—'; tr.appendChild(td);\n      });\n      var actions = document.createElement('td'), edit = document.createElement('button'), del = document.createElement('button');\n      edit.textContent = '✎'; edit.title = 'Editar';\n      edit.onclick = function () { editingId = row.id; renderForm(); log('Editando registro #' + row.id); };\n      del.textContent = '🗑'; del.title = 'Excluir';\n      del.onclick = function () {\n        if (!window.confirm('Excluir registro #' + row.id + '?')) return;\n        table().rows = table().rows.filter(function (r) { return r.id !== row.id; });\n        if (editingId === row.id) { editingId = null; renderForm(); }\n        persist(); renderAll(); log('Registro #' + row.id + ' excluido');\n      };\n      actions.appendChild(edit); actions.appendChild(del); tr.appendChild(actions); tbody.appendChild(tr);\n    });\n    t.appendChild(tbody); wrap.appendChild(t);\n    if (!rows.length) { var empty = document.createElement('div'); empty.className = 'qz-empty'; empty.textContent = 'Nenhum registro encontrado.'; wrap.appendChild(empty); }\n    $('count').textContent = rows.length + ' de ' + table().rows.length + ' registros';\n  }\n  function renderForm() {\n    var box = $('formFields'); box.innerHTML = '';\n    var row = null;\n    if (editingId) row = table().rows.filter(function (r) { return r.id === editingId; })[0] || null;\n    table().fields.forEach(function (f) {\n      var label = document.createElement('label'), input = document.createElement('input');\n      label.textContent = f.name;\n      input.type = f.type === 'number' ? 'number' : (f.type === 'date' ? 'date' : 'text');\n      input.setAttribute('data-field', f.name);\n      input.value = row ? (row.values[f.name] || '') : '';\n      label.appendChild(input); box.appendChild(label);\n    });\n    $('formTitle').textContent = editingId ? 'Editando registro #' + editingId : 'Novo registro';\n    $('submit').textContent = editingId ? '💾 Atualizar' : '➕ Adicionar';\n  }\n  function renderAll() { renderTables(); renderFields(); renderRecords(); renderForm(); }\n  function addField() {\n    var name = $('fieldName').value.trim(), type = $('fieldType').value;\n    if (!name) { log('Informe o nome do campo'); return; }\n    if (table().fields.some(function (f) { return f.name.toLowerCase() === name.toLowerCase(); })) { log('Campo ja existe: ' + name); return; }\n    table().fields.push({ name: name, type: type });\n    table().rows.forEach(function (r) { r.values[name] = ''; });\n    $('fieldName').value = ''; persist(); renderAll(); log('Campo adicionado: ' + name + ' (' + type + ')');\n  }\n  function removeField(i) {\n    var name = table().fields[i].name;\n    if (!window.confirm('Remover campo ' + name + ' e seus valores?')) return;\n    table().fields.splice(i, 1);\n    table().rows.forEach(function (r) { delete r.values[name]; });\n    persist(); renderAll(); log('Campo removido: ' + name);\n  }\n  function addTable() {\n    var name = $('newTable').value.trim();\n    if (!name) { log('Informe o nome da tabela'); return; }\n    if (db.tables.some(function (t) { return t.name.toLowerCase() === name.toLowerCase(); })) { log('Tabela ja existe: ' + name); return; }\n    db.tables.push({ name: name, fields: [{ name: 'Nome', type: 'text' }], rows: [] });\n    db.active = db.tables.length - 1; editingId = null;\n    $('newTable').value = ''; persist(); renderAll(); log('Tabela criada: ' + name);\n  }\n  function exportJson() {\n    var text = JSON.stringify(db, null, 2);\n    parent.postMessage({ type: 'QZ_SAVE_FILE', name: 'quinzeta-db.json', mimeType: 'application/json', fileType: 'application/json', content: text }, '*');\n    log('JSON exportado via QZ_SAVE_FILE · ' + text.length + ' caracteres');\n  }\n  $('addTable').onclick = addTable;\n  $('newTable').addEventListener('keydown', function (e) { if (e.key === 'Enter') addTable(); });\n  $('tables').onchange = function () { db.active = parseInt(this.value, 10); editingId = null; persist(); renderAll(); log('Tabela ativa: ' + table().name); };\n  $('addField').onclick = addField;\n  $('fieldName').addEventListener('keydown', function (e) { if (e.key === 'Enter') addField(); });\n  $('search').addEventListener('input', renderRecords);\n  $('clearSearch').onclick = function () { $('search').value = ''; renderRecords(); };\n  $('save').onclick = function () { log(persist() ? 'Banco salvo no localStorage' : 'Banco mantido em memoria'); };\n  $('export').onclick = exportJson;\n  $('cancel').onclick = function () { editingId = null; renderForm(); };\n  $('form').addEventListener('submit', function (e) {\n    e.preventDefault();\n    var values = {};\n    table().fields.forEach(function (f) {\n      var inp = $('formFields').querySelector('[data-field=\"' + f.name + '\"]');\n      values[f.name] = inp ? inp.value : '';\n    });\n    if (editingId) {\n      var row = table().rows.filter(function (r) { return r.id === editingId; })[0];\n      if (row) row.values = values;\n      log('Registro #' + editingId + ' atualizado'); editingId = null;\n    } else {\n      var id = nextId++;\n      table().rows.push({ id: id, values: values });\n      log('Registro #' + id + ' adicionado em ' + table().name);\n    }\n    persist(); renderAll();\n  });\n  load(); renderAll();\n  log('Quinzeta DB pronto · ' + db.tables.length + ' tabela(s)');\n})();"
}
