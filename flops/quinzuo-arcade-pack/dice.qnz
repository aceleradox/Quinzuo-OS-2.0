{
  "format": "qnz",
  "version": 1,
  "title": "Dice Game — Quinzuo Arcade",
  "name": "Dice Game — Quinzuo Arcade",
  "icon": "🎲",
  "description": "Jogo de dados com animação, soma dos resultados, recorde e histórico.",
  "theme": {
    "primary": "#8b5cf6",
    "cyan": "#06b6d4",
    "background": "#0f172a",
    "dockStyle": "glass"
  },
  "window": {
    "width": 470,
    "height": 560,
    "resizable": true
  },
  "html": "\n<div class=\"qz-wrap\">\n  <header class=\"qz-head\"><div style=\"display:flex;gap:9px;align-items:center\"><span class=\"qz-ico\">🎲</span><div><b>Dice Game</b><small>Quinzuo Arcade · some os dados</small></div></div></header>\n  <div class=\"qz-hud\"><div class=\"qz-stat\"><span>Pontuação</span><b id=\"score\">0</b></div><div class=\"qz-stat\"><span>Melhor</span><b id=\"best\">0</b></div><div class=\"qz-stat\"><span>Rolagens</span><b id=\"rolls\">0</b></div></div>\n  <div class=\"qz-controls\"><label>Dados <select id=\"count\"><option>1</option><option>2</option><option selected>3</option><option>4</option><option>5</option></select></label><button id=\"roll\" class=\"qz-btn qz-btn-primary\">🎲 Jogar dados</button><button id=\"reset\" class=\"qz-btn\">↻ Reiniciar</button></div>\n  <div class=\"qz-stage\"><div id=\"dice\" class=\"qz-dice\"></div></div>\n  <div class=\"qz-history\"><div class=\"qz-pane-title\">HISTÓRICO</div><div id=\"history\">// nenhuma rolagem ainda</div></div>\n  <div class=\"qz-log\" id=\"log\">// log do Dice Game</div>\n</div>",
  "css": "\n.qz-wrap{font-family:ui-sans-serif,system-ui,sans-serif;color:#e2e8f0}\n.qz-head{display:flex;justify-content:space-between;align-items:center;padding:9px 13px;border-bottom:1px solid rgba(139,92,246,.28);background:rgba(139,92,246,.08);border-radius:12px 12px 0 0}\n.qz-head b{font-size:14px}.qz-head small{display:block;font-size:10px;color:#94a3b8}\n.qz-ico{font-size:23px}\n.qz-hud{display:flex;flex-wrap:wrap;gap:9px;padding:11px 13px 0}\n.qz-stat{flex:1;min-width:88px;background:rgba(15,23,42,.75);border:1px solid rgba(148,163,184,.16);border-radius:10px;padding:7px 10px}\n.qz-stat span{display:block;font-size:9px;letter-spacing:1.2px;color:#94a3b8;text-transform:uppercase}\n.qz-stat b{font-size:17px;color:#22d3ee}\n.qz-btn{cursor:pointer;border:1px solid rgba(148,163,184,.3);background:#111c33;color:#e2e8f0;padding:8px 12px;border-radius:9px;font-size:12px;font-weight:600}\n.qz-btn:hover{border-color:#8b5cf6;transform:translateY(-1px)}\n.qz-btn-primary{background:linear-gradient(135deg,#7c3aed,#a855f7);border-color:transparent}\n.qz-btn-cyan{background:linear-gradient(135deg,#0891b2,#22d3ee);border-color:transparent;color:#04121b}\n.qz-stage{display:flex;justify-content:center;padding:12px}\n.qz-foot{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:0 13px 12px;flex-wrap:wrap}\n.qz-status{font-size:11px;color:#a78bfa}\n.qz-log{font:10px/1.5 ui-monospace,monospace;color:#64748b;margin:0 13px 12px;border-top:1px solid rgba(148,163,184,.12);padding-top:7px;max-height:52px;overflow:auto;white-space:pre-wrap}\n.qz-controls{display:flex;gap:9px;align-items:center;flex-wrap:wrap;padding:10px 13px 0}\n.qz-controls label{font-size:11px;color:#cbd5e1}\n.qz-controls select{background:#0f172a;color:#e2e8f0;border:1px solid rgba(139,92,246,.4);border-radius:8px;padding:6px;margin-left:6px}\n.qz-dice{display:flex;gap:12px;flex-wrap:wrap;justify-content:center}\n.qz-die{width:74px;height:74px;display:flex;align-items:center;justify-content:center;font-size:44px;border-radius:15px;background:linear-gradient(145deg,#312e81,#0f172a);border:1px solid rgba(34,211,238,.4);box-shadow:0 7px 18px rgba(0,0,0,.35)}\n.qz-history{margin:0 13px 10px;font-size:11px;color:#cbd5e1;background:rgba(15,23,42,.7);border:1px solid rgba(148,163,184,.15);border-radius:10px;padding:8px 10px;min-height:48px;max-height:80px;overflow:auto}\n.qz-pane-title{font-size:9px;letter-spacing:1.4px;color:#a78bfa;margin-bottom:5px}",
  "js": "\n(function () {\n  var NL = String.fromCharCode(10);\n  var $ = function (id) { return document.getElementById(id); };\n  var faces = ['', '⚀', '⚁', '⚂', '⚃', '⚄', '⚅'];\n  var values = [], rolls = 0, best = 0, spinning = false;\n  function log(m) { $('log').textContent += '[' + new Date().toLocaleTimeString('pt-BR') + '] ' + m + NL; console.log('[dice] ' + m); }\n  function loadBest() { try { return parseInt(localStorage.getItem('qz_dice_best'), 10) || 0; } catch (e) { return 0; } }\n  function saveBest(v) { try { localStorage.setItem('qz_dice_best', String(v)); } catch (e) {} }\n  function hud() { $('score').textContent = values.reduce(function (a, b) { return a + b; }, 0); $('best').textContent = best; $('rolls').textContent = rolls; }\n  function render(vals) {\n    var box = $('dice'); box.innerHTML = '';\n    vals.forEach(function (v) {\n      var d = document.createElement('div'); d.className = 'qz-die'; d.textContent = faces[v]; box.appendChild(d);\n    });\n  }\n  function reset() {\n    values = [1, 1, 1]; rolls = 0; best = loadBest(); spinning = false;\n    $('history').textContent = '// nenhuma rolagem ainda';\n    render(values); hud(); log('Jogo reiniciado');\n  }\n  function roll() {\n    if (spinning) return;\n    spinning = true;\n    var n = parseInt($('count').value, 10), ticks = 0;\n    var anim = setInterval(function () {\n      values = [];\n      for (var i = 0; i < n; i++) values.push(1 + Math.floor(Math.random() * 6));\n      render(values);\n      ticks++;\n      if (ticks >= 6) {\n        clearInterval(anim); spinning = false;\n        var sum = values.reduce(function (a, b) { return a + b; }, 0);\n        rolls++;\n        if (sum > best) { best = sum; saveBest(best); }\n        hud();\n        var line = '#' + rolls + ' [' + values.join('+') + '] = ' + sum;\n        $('history').textContent = $('history').textContent === '// nenhuma rolagem ainda' ? line : line + NL + $('history').textContent;\n        log(line + (sum === best ? ' · novo recorde!' : ''));\n      }\n    }, 95);\n  }\n  $('roll').onclick = roll;\n  $('reset').onclick = reset;\n  reset();\n})();"
}
