{
  "format": "qnz",
  "version": 1,
  "title": "Memory Game — Quinzuo Arcade",
  "name": "Memory Game — Quinzuo Arcade",
  "icon": "🧠",
  "description": "Jogo da memória com 8 pares, cronômetro, pontuação e reinício.",
  "theme": {
    "primary": "#8b5cf6",
    "cyan": "#06b6d4",
    "background": "#0f172a",
    "dockStyle": "glass"
  },
  "window": {
    "width": 460,
    "height": 580,
    "resizable": true
  },
  "html": "\n<div class=\"qz-wrap\">\n  <header class=\"qz-head\"><div style=\"display:flex;gap:9px;align-items:center\"><span class=\"qz-ico\">🧠</span><div><b>Memory Game</b><small>Quinzuo Arcade · encontre os 8 pares</small></div></div></header>\n  <div class=\"qz-hud\"><div class=\"qz-stat\"><span>Pontos</span><b id=\"score\">0</b></div><div class=\"qz-stat\"><span>Jogadas</span><b id=\"moves\">0</b></div><div class=\"qz-stat\"><span>Tempo</span><b id=\"time\">0s</b></div></div>\n  <div class=\"qz-stage\"><div id=\"grid\" class=\"qz-grid\"></div></div>\n  <div class=\"qz-foot\"><div><button id=\"restart\" class=\"qz-btn qz-btn-primary\">↻ Reiniciar</button></div><div class=\"qz-status\" id=\"status\">Clique em duas cartas.</div></div>\n  <div class=\"qz-log\" id=\"log\">// log do Memory Game</div>\n</div>",
  "css": "\n.qz-wrap{font-family:ui-sans-serif,system-ui,sans-serif;color:#e2e8f0}\n.qz-head{display:flex;justify-content:space-between;align-items:center;padding:9px 13px;border-bottom:1px solid rgba(139,92,246,.28);background:rgba(139,92,246,.08);border-radius:12px 12px 0 0}\n.qz-head b{font-size:14px}.qz-head small{display:block;font-size:10px;color:#94a3b8}\n.qz-ico{font-size:23px}\n.qz-hud{display:flex;flex-wrap:wrap;gap:9px;padding:11px 13px 0}\n.qz-stat{flex:1;min-width:88px;background:rgba(15,23,42,.75);border:1px solid rgba(148,163,184,.16);border-radius:10px;padding:7px 10px}\n.qz-stat span{display:block;font-size:9px;letter-spacing:1.2px;color:#94a3b8;text-transform:uppercase}\n.qz-stat b{font-size:17px;color:#22d3ee}\n.qz-btn{cursor:pointer;border:1px solid rgba(148,163,184,.3);background:#111c33;color:#e2e8f0;padding:8px 12px;border-radius:9px;font-size:12px;font-weight:600}\n.qz-btn:hover{border-color:#8b5cf6;transform:translateY(-1px)}\n.qz-btn-primary{background:linear-gradient(135deg,#7c3aed,#a855f7);border-color:transparent}\n.qz-btn-cyan{background:linear-gradient(135deg,#0891b2,#22d3ee);border-color:transparent;color:#04121b}\n.qz-stage{display:flex;justify-content:center;padding:12px}\n.qz-foot{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:0 13px 12px;flex-wrap:wrap}\n.qz-status{font-size:11px;color:#a78bfa}\n.qz-log{font:10px/1.5 ui-monospace,monospace;color:#64748b;margin:0 13px 12px;border-top:1px solid rgba(148,163,184,.12);padding-top:7px;max-height:52px;overflow:auto;white-space:pre-wrap}\n.qz-grid{display:grid;grid-template-columns:repeat(4,70px);gap:8px}\n.qz-card{width:70px;height:70px;cursor:pointer;font-size:30px;border:1px solid rgba(139,92,246,.4);border-radius:11px;background:linear-gradient(145deg,#1e1b4b,#0f172a);color:#f8fafc;transition:transform .16s,box-shadow .16s}\n.qz-card:hover{transform:scale(1.04);box-shadow:0 0 14px rgba(139,92,246,.35)}\n.qz-card.open{background:linear-gradient(145deg,#4c1d95,#0e7490);border-color:#22d3ee}\n.qz-card.done{background:linear-gradient(145deg,#065f46,#0e7490);border-color:#34d399;opacity:.85}\n.qz-status{padding:0 13px 8px;text-align:right}",
  "js": "\n(function () {\n  var NL = String.fromCharCode(10);\n  var $ = function (id) { return document.getElementById(id); };\n  var icons = ['🐍', '🧠', '🎲', '🚀', '⚡', '🌐', '💎', '🔥'];\n  var deck = [], first = null, lock = false, moves = 0, matched = 0, seconds = 0, tick = null;\n  function log(m) { $('log').textContent += '[' + new Date().toLocaleTimeString('pt-BR') + '] ' + m + NL; console.log('[memory] ' + m); }\n  function shuffle(a) { for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)), t = a[i]; a[i] = a[j]; a[j] = t; } return a; }\n  function hud() {\n    $('moves').textContent = moves;\n    $('time').textContent = seconds + 's';\n    $('score').textContent = Math.max(0, 1000 - moves * 10 - seconds * 2);\n  }\n  function render() {\n    var grid = $('grid'); grid.innerHTML = '';\n    deck.forEach(function (card, i) {\n      var b = document.createElement('button');\n      b.className = 'qz-card' + (card.done ? ' done' : (card.open ? ' open' : ''));\n      b.textContent = card.open || card.done ? card.icon : '❓';\n      b.onclick = function () { flip(i); };\n      grid.appendChild(b);\n    });\n  }\n  function win() {\n    clearInterval(tick); tick = null;\n    var pts = Math.max(0, 1000 - moves * 10 - seconds * 2);\n    $('status').textContent = ' Você venceu! Pontuação final: ' + pts;\n    log('Vitória em ' + moves + ' jogadas / ' + seconds + 's · ' + pts + ' pontos');\n  }\n  function flip(i) {\n    if (lock || deck[i].open || deck[i].done) return;\n    deck[i].open = true; render();\n    if (first === null) { first = i; return; }\n    var a = first, b = i;\n    first = null; moves++; lock = true; hud();\n    if (deck[a].icon === deck[b].icon) {\n      $('status').textContent = 'Par encontrado: ' + deck[a].icon;\n      setTimeout(function () {\n        deck[a].done = true; deck[b].done = true; matched++;\n        lock = false; render();\n        log('Par ' + matched + '/8 · ' + deck[a].icon);\n        if (matched === 8) win();\n      }, 350);\n    } else {\n      $('status').textContent = 'Não combinam...';\n      setTimeout(function () {\n        deck[a].open = false; deck[b].open = false;\n        lock = false; render();\n      }, 700);\n    }\n  }\n  function restart() {\n    if (tick) clearInterval(tick);\n    deck = shuffle(icons.concat(icons)).map(function (ic, i) { return { id: i, icon: ic, open: false, done: false }; });\n    first = null; lock = false; moves = 0; matched = 0; seconds = 0;\n    tick = setInterval(function () { seconds++; hud(); }, 1000);\n    $('status').textContent = 'Clique em duas cartas.';\n    hud(); render(); log('Novo jogo iniciado');\n  }\n  $('restart').onclick = restart;\n  restart();\n})();"
}
