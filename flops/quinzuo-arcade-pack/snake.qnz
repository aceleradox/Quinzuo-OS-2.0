{
  "format": "qnz",
  "version": 1,
  "title": "Snake Game — Quinzuo Arcade",
  "name": "Snake Game — Quinzuo Arcade",
  "icon": "🐍",
  "description": "Clássico Snake jogável com teclado ou D-pad, pontuação e recorde.",
  "theme": {
    "primary": "#8b5cf6",
    "cyan": "#06b6d4",
    "background": "#0f172a",
    "dockStyle": "glass"
  },
  "window": {
    "width": 480,
    "height": 620,
    "resizable": true
  },
  "html": "\n<div class=\"qz-wrap\">\n  <header class=\"qz-head\"><div style=\"display:flex;gap:9px;align-items:center\"><span class=\"qz-ico\">🐍</span><div><b>Snake Game</b><small>Quinzuo Arcade · setas / WASD ou D-pad</small></div></div><span class=\"qz-chip\">16 × 16</span></header>\n  <div class=\"qz-hud\"><div class=\"qz-stat\"><span>Pontuação</span><b id=\"score\">0</b></div><div class=\"qz-stat\"><span>Recorde</span><b id=\"best\">0</b></div><div class=\"qz-stat\"><span>Tamanho</span><b id=\"size\">3</b></div></div>\n  <div class=\"qz-stage\"><canvas id=\"board\" width=\"320\" height=\"320\"></canvas></div>\n  <div class=\"qz-foot\"><div><button id=\"start\" class=\"qz-btn qz-btn-primary\">▶ Iniciar</button> <button id=\"reset\" class=\"qz-btn\">↻ Reiniciar</button></div>\n    <div class=\"qz-dpad\"><button data-x=\"0\" data-y=\"-1\">↑</button><button data-x=\"-1\" data-y=\"0\">←</button><button data-x=\"0\" data-y=\"1\">↓</button><button data-x=\"1\" data-y=\"0\">→</button></div></div>\n  <div class=\"qz-status\" id=\"status\">Pressione Iniciar para jogar.</div>\n  <div class=\"qz-log\" id=\"log\">// log do Snake Game</div>\n</div>",
  "css": "\n.qz-wrap{font-family:ui-sans-serif,system-ui,sans-serif;color:#e2e8f0}\n.qz-head{display:flex;justify-content:space-between;align-items:center;padding:9px 13px;border-bottom:1px solid rgba(139,92,246,.28);background:rgba(139,92,246,.08);border-radius:12px 12px 0 0}\n.qz-head b{font-size:14px}.qz-head small{display:block;font-size:10px;color:#94a3b8}\n.qz-ico{font-size:23px}\n.qz-hud{display:flex;flex-wrap:wrap;gap:9px;padding:11px 13px 0}\n.qz-stat{flex:1;min-width:88px;background:rgba(15,23,42,.75);border:1px solid rgba(148,163,184,.16);border-radius:10px;padding:7px 10px}\n.qz-stat span{display:block;font-size:9px;letter-spacing:1.2px;color:#94a3b8;text-transform:uppercase}\n.qz-stat b{font-size:17px;color:#22d3ee}\n.qz-btn{cursor:pointer;border:1px solid rgba(148,163,184,.3);background:#111c33;color:#e2e8f0;padding:8px 12px;border-radius:9px;font-size:12px;font-weight:600}\n.qz-btn:hover{border-color:#8b5cf6;transform:translateY(-1px)}\n.qz-btn-primary{background:linear-gradient(135deg,#7c3aed,#a855f7);border-color:transparent}\n.qz-btn-cyan{background:linear-gradient(135deg,#0891b2,#22d3ee);border-color:transparent;color:#04121b}\n.qz-stage{display:flex;justify-content:center;padding:12px}\n.qz-foot{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:0 13px 12px;flex-wrap:wrap}\n.qz-status{font-size:11px;color:#a78bfa}\n.qz-log{font:10px/1.5 ui-monospace,monospace;color:#64748b;margin:0 13px 12px;border-top:1px solid rgba(148,163,184,.12);padding-top:7px;max-height:52px;overflow:auto;white-space:pre-wrap}\n.qz-chip{font-size:10px;color:#22d3ee;border:1px solid rgba(6,182,212,.4);border-radius:99px;padding:3px 8px}\n#board{background:#080e1d;border:1px solid rgba(6,182,212,.32);border-radius:12px;box-shadow:0 8px 30px rgba(0,0,0,.35)}\n.qz-dpad{display:grid;grid-template-columns:repeat(3,34px);grid-template-rows:repeat(2,34px);gap:4px;direction:rtl}\n.qz-dpad button{cursor:pointer;background:rgba(139,92,246,.16);border:1px solid rgba(139,92,246,.45);color:#e2e8f0;border-radius:8px;font-size:15px}\n.qz-dpad button:nth-child(1){grid-column:2}.qz-dpad button:nth-child(2){grid-column:1;grid-row:2}.qz-dpad button:nth-child(3){grid-column:2;grid-row:2}.qz-dpad button:nth-child(4){grid-column:3;grid-row:2}\n.qz-status{padding:0 13px 8px}",
  "js": "\n(function () {\n  var NL = String.fromCharCode(10);\n  var $ = function (id) { return document.getElementById(id); };\n  var canvas = $('board'), ctx = canvas.getContext('2d'), cell = 20, cols = 16, rows = 16;\n  var snake, dir, nextDir, food, score, best, timer = null, running = false, over = false;\n  function log(m) { $('log').textContent += '[' + new Date().toLocaleTimeString('pt-BR') + '] ' + m + NL; console.log('[snake] ' + m); }\n  function loadBest() { try { return parseInt(localStorage.getItem('qz_snake_best'), 10) || 0; } catch (e) { return 0; } }\n  function saveBest(v) { try { localStorage.setItem('qz_snake_best', String(v)); } catch (e) {} }\n  function placeFood() {\n    var ok = false;\n    while (!ok) {\n      food = { x: Math.floor(Math.random() * cols), y: Math.floor(Math.random() * rows) };\n      ok = !snake.some(function (p) { return p.x === food.x && p.y === food.y; });\n    }\n  }\n  function hud() { $('score').textContent = score; $('best').textContent = best; $('size').textContent = snake.length; }\n  function draw() {\n    ctx.fillStyle = '#080e1d'; ctx.fillRect(0, 0, canvas.width, canvas.height);\n    ctx.strokeStyle = 'rgba(6,182,212,0.07)'; ctx.lineWidth = 1;\n    for (var i = 0; i <= cols; i++) { ctx.beginPath(); ctx.moveTo(i * cell, 0); ctx.lineTo(i * cell, rows * cell); ctx.stroke(); }\n    for (var j = 0; j <= rows; j++) { ctx.beginPath(); ctx.moveTo(0, j * cell); ctx.lineTo(cols * cell, j * cell); ctx.stroke(); }\n    var g = ctx.createRadialGradient(food.x * cell + 10, food.y * cell + 10, 2, food.x * cell + 10, food.y * cell + 10, 11);\n    g.addColorStop(0, '#67e8f9'); g.addColorStop(1, '#0891b2');\n    ctx.fillStyle = g; ctx.beginPath(); ctx.arc(food.x * cell + 10, food.y * cell + 10, 7, 0, Math.PI * 2); ctx.fill();\n    snake.forEach(function (p, idx) {\n      var grad = ctx.createLinearGradient(p.x * cell, p.y * cell, p.x * cell + cell, p.y * cell + cell);\n      grad.addColorStop(0, idx === 0 ? '#a855f7' : '#7c3aed');\n      grad.addColorStop(1, idx === 0 ? '#22d3ee' : '#4c1d95');\n      ctx.fillStyle = grad;\n      ctx.fillRect(p.x * cell + 1.5, p.y * cell + 1.5, cell - 3, cell - 3);\n    });\n    if (over) {\n      ctx.fillStyle = 'rgba(8,14,29,0.78)'; ctx.fillRect(0, 0, canvas.width, canvas.height);\n      ctx.fillStyle = '#f8fafc'; ctx.font = 'bold 24px system-ui'; ctx.textAlign = 'center';\n      ctx.fillText('FIM DE JOGO', canvas.width / 2, canvas.height / 2 - 6);\n      ctx.font = '14px system-ui'; ctx.fillStyle = '#22d3ee';\n      ctx.fillText('Pontos: ' + score, canvas.width / 2, canvas.height / 2 + 20);\n    }\n  }\n  function reset() {\n    if (timer) { clearInterval(timer); timer = null; }\n    snake = [{ x: 7, y: 8 }, { x: 6, y: 8 }, { x: 5, y: 8 }];\n    dir = { x: 1, y: 0 }; nextDir = { x: 1, y: 0 };\n    score = 0; over = false; running = false; best = loadBest();\n    placeFood(); hud(); draw();\n    $('status').textContent = 'Pressione Iniciar para jogar.';\n    log('Jogo reiniciado');\n  }\n  function finish() {\n    over = true; running = false;\n    if (timer) { clearInterval(timer); timer = null; }\n    $('status').textContent = 'Fim de jogo · pontuação ' + score;\n    log('Fim de jogo · ' + score + ' pontos');\n    draw();\n  }\n  function step() {\n    dir = nextDir;\n    var head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };\n    if (head.x < 0 || head.y < 0 || head.x >= cols || head.y >= rows) return finish();\n    for (var i = 0; i < snake.length; i++) if (snake[i].x === head.x && snake[i].y === head.y) return finish();\n    snake.unshift(head);\n    if (food.x === head.x && food.y === head.y) {\n      score += 10;\n      if (score > best) { best = score; saveBest(best); }\n      placeFood(); hud(); log('Comeu! +10 · total ' + score);\n    } else snake.pop();\n    draw();\n  }\n  function start() {\n    if (over) reset();\n    if (running) return;\n    running = true;\n    timer = setInterval(step, 110);\n    $('status').textContent = 'Jogando...';\n    log('Iniciado');\n  }\n  function turn(x, y) {\n    if (dir.x === -x && dir.y === -y) return;\n    nextDir = { x: x, y: y };\n    if (!running) start();\n  }\n  var keyMap = {\n    ArrowUp: [0, -1], ArrowLeft: [-1, 0], ArrowDown: [0, 1], ArrowRight: [1, 0],\n    w: [0, -1], a: [-1, 0], s: [0, 1], d: [1, 0]\n  };\n  window.addEventListener('keydown', function (e) {\n    var k = e.key.length === 1 ? e.key.toLowerCase() : e.key;\n    var m = keyMap[k];\n    if (m) { e.preventDefault(); turn(m[0], m[1]); }\n  });\n  Array.prototype.forEach.call(document.querySelectorAll('.qz-dpad button'), function (b) {\n    b.onclick = function () { turn(parseInt(b.getAttribute('data-x'), 10), parseInt(b.getAttribute('data-y'), 10)); };\n  });\n  $('start').onclick = start;\n  $('reset').onclick = reset;\n  reset();\n})();"
}
