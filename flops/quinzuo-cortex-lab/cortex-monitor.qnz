{
  "format": "qnz",
  "version": 1,
  "title": "Cortex Monitor — Quinzuo Lab",
  "name": "Cortex Monitor — Quinzuo Lab",
  "icon": "🧬",
  "description": "Painel do córtex com gráfico canvas animado, sliders de frequência/capacidade e frases do boot.",
  "theme": {
    "primary": "#8b5cf6",
    "cyan": "#06b6d4",
    "background": "#0f172a",
    "dockStyle": "glass"
  },
  "window": {
    "width": 820,
    "height": 600,
    "resizable": true
  },
  "html": "\n<div class=\"qz-wrap\">\n  <header class=\"qz-head\"><div style=\"display:flex;gap:9px;align-items:center\"><span class=\"qz-ico\">🧬</span><div><b id=\"qzTitle\">🧬 Quinzuo Cortex Lab</b><small>monitor córtex · kernel cognitivo</small></div></div><span class=\"qz-chip\" id=\"state\">● ONLINE</span></header>\n  <div class=\"qz-main\">\n    <div class=\"qz-canvas-box\"><canvas id=\"cortex\" width=\"760\" height=\"230\"></canvas><span class=\"qz-tag\">SINAL CORTICAL / TEMPO REAL</span></div>\n    <div class=\"qz-grid\">\n      <div class=\"qz-group\"><label>Frequência <b id=\"freqVal\">3.2 Hz</b></label><input id=\"freq\" type=\"range\" min=\"0.5\" max=\"12\" value=\"3.2\" step=\"0.1\"></div>\n      <div class=\"qz-group\"><label>Capacidade <b id=\"capVal\">78%</b></label><input id=\"cap\" type=\"range\" min=\"10\" max=\"100\" value=\"78\" step=\"1\"></div>\n    </div>\n    <div class=\"qz-metrics\"><div><span>SINCRONIA</span><b id=\"sync\">--</b></div><div><span>AMOSTRA</span><b id=\"tick\">0</b></div><div><span>UPTIME</span><b id=\"uptime\">0s</b></div></div>\n    <div class=\"qz-phrase\" id=\"phrase\">// inicializando córtex...</div>\n    <div class=\"qz-actions\"><button id=\"next\" class=\"qz-btn qz-btn-primary\">➜ Próxima frase</button><button id=\"pause\" class=\"qz-btn\">⏸ Pausar gráfico</button></div>\n  </div>\n  <div class=\"qz-log\" id=\"log\">// log do córtex</div>\n</div>",
  "css": "\n.qz-wrap{font-family:ui-sans-serif,system-ui,sans-serif;color:#e2e8f0}\n.qz-head{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;border-bottom:1px solid rgba(139,92,246,.3);background:rgba(139,92,246,.09);border-radius:12px 12px 0 0}\n.qz-head b{font-size:14px}.qz-head small{font-size:10px;color:#94a3b8;display:block}\n.qz-ico{font-size:23px}.qz-chip{font-size:10px;color:#22d3ee;border:1px solid rgba(6,182,212,.4);border-radius:99px;padding:3px 9px}\n.qz-main{padding:12px;display:flex;flex-direction:column;gap:11px}\n.qz-canvas-box{position:relative;border:1px solid rgba(6,182,212,.28);border-radius:12px;overflow:hidden;background:#050a16}\n.qz-canvas-box canvas{display:block;width:100%;height:230px}\n.qz-tag{position:absolute;top:8px;left:10px;font-size:9px;letter-spacing:1.5px;color:rgba(34,211,238,.7)}\n.qz-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n.qz-group label{display:flex;justify-content:space-between;font-size:11px;color:#cbd5e1;margin-bottom:4px}\n.qz-group label b{color:#22d3ee}.qz-group input[type=range]{width:100%;accent-color:#8b5cf6}\n.qz-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}\n.qz-metrics div{background:rgba(15,23,42,.7);border:1px solid rgba(148,163,184,.16);border-radius:10px;padding:7px 10px}\n.qz-metrics span{display:block;font-size:9px;letter-spacing:1.3px;color:#94a3b8}\n.qz-metrics b{font-size:16px;color:#a78bfa}\n.qz-phrase{font:12px/1.5 ui-monospace,monospace;color:#67e8f9;background:rgba(6,182,212,.07);border-left:3px solid #06b6d4;border-radius:6px;padding:9px 11px;min-height:38px}\n.qz-btn{cursor:pointer;border:1px solid rgba(148,163,184,.3);background:#111c33;color:#e2e8f0;padding:8px 12px;border-radius:9px;font-size:12px;font-weight:600}\n.qz-btn:hover{border-color:#8b5cf6;transform:translateY(-1px)}\n.qz-btn-primary{background:linear-gradient(135deg,#7c3aed,#a855f7);border-color:transparent}\n.qz-log{font:10px/1.5 ui-monospace,monospace;color:#64748b;margin:0 13px 11px;border-top:1px solid rgba(148,163,184,.12);padding-top:7px;max-height:52px;overflow:auto;white-space:pre-wrap}\n@media(max-width:650px){.qz-grid,.qz-metrics{grid-template-columns:1fr}}",
  "js": "\n(function () {\n  var NL = String.fromCharCode(10);\n  var $ = function (id) { return document.getElementById(id); };\n  var info = window.__QZ_QNZ__ || { title: 'Quinzuo Cortex Lab', icon: '🧬' };\n  var canvas = $('cortex'), ctx = canvas.getContext('2d');\n  var phrases = [\n    'Kernel cognitivo online · sincronizando córtex...',\n    'Carregando memória associativa do Quinzuo OS...',\n    'Fluxo quântico estável. Nenhuma anomalia detectada.',\n    'Canal 🧬 calibrado · latência neural mínima.',\n    'Boot do córtex concluído. Taxa de acerto: 98.7%.',\n    'Sinapse sintética ativa · aguardando nova instrução.'\n  ];\n  var idx = 0, frames = 0, running = true, started = Date.now();\n  function log(m) { $('log').textContent += '[' + new Date().toLocaleTimeString('pt-BR') + '] ' + m + NL; console.log('[cortex] ' + m); }\n  $('qzTitle').textContent = (info.icon || '🧬') + ' ' + (info.title || 'Quinzuo Cortex Lab');\n  function nextPhrase() {\n    idx = (idx + 1) % phrases.length;\n    $('phrase').textContent = '> ' + phrases[idx];\n    log('Frase do boot #' + (idx + 1));\n  }\n  function syncLabels() {\n    $('freqVal').textContent = parseFloat($('freq').value).toFixed(1) + ' Hz';\n    $('capVal').textContent = $('cap').value + '%';\n  }\n  function render() {\n    var w = canvas.width, h = canvas.height;\n    var freq = parseFloat($('freq').value), cap = parseFloat($('cap').value) / 100;\n    var t = frames * 0.016;\n    ctx.fillStyle = '#050a16'; ctx.fillRect(0, 0, w, h);\n    ctx.lineWidth = 1; ctx.strokeStyle = 'rgba(139,92,246,0.10)';\n    for (var x = 0; x < w; x += 38) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke(); }\n    for (var y = 0; y < h; y += 32) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke(); }\n    var colors = ['#8b5cf6', '#22d3ee', '#a855f7'];\n    for (var k = 0; k < 3; k++) {\n      ctx.beginPath();\n      ctx.strokeStyle = colors[k]; ctx.lineWidth = 1.6 + k * 0.4;\n      ctx.globalAlpha = 0.85 - k * 0.18;\n      for (var px = 0; px <= w; px += 3) {\n        var phase = px / w * Math.PI * 2 * (1 + k) + t * freq * (1 + k * 0.35);\n        var amp = (h * 0.16 + 8 * Math.sin(t * 0.6 + k)) * cap * (1 - k * 0.16);\n        var py = h / 2 + Math.sin(phase) * amp + Math.sin(phase * 3.7 + k) * amp * 0.18;\n        if (px === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);\n      }\n      ctx.stroke();\n    }\n    ctx.globalAlpha = 1;\n    for (var p = 0; p < 5; p++) {\n      var bx = (frames * (0.6 + p * 0.14) + p * 170) % w;\n      var by = h / 2 + Math.sin(t * freq + p) * h * 0.22 * cap;\n      var g = ctx.createRadialGradient(bx, by, 1, bx, by, 15);\n      g.addColorStop(0, 'rgba(34,211,238,0.65)'); g.addColorStop(1, 'rgba(34,211,238,0)');\n      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(bx, by, 15, 0, Math.PI * 2); ctx.fill();\n    }\n    frames++;\n    $('tick').textContent = frames;\n    $('sync').textContent = Math.round(cap * 100 - 4 + 4 * Math.sin(t)) + '%';\n    $('uptime').textContent = Math.floor((Date.now() - started) / 1000) + 's';\n  }\n  function loop() { if (running) render(); requestAnimationFrame(loop); }\n  $('freq').addEventListener('input', syncLabels);\n  $('cap').addEventListener('input', syncLabels);\n  $('next').onclick = nextPhrase;\n  $('pause').onclick = function () {\n    running = !running;\n    $('pause').textContent = running ? '⏸ Pausar gráfico' : '▶ Retomar gráfico';\n    $('state').textContent = running ? '● ONLINE' : '❚❚ PAUSADO';\n    log(running ? 'Gráfico retomado' : 'Gráfico pausado');\n  };\n  window.addEventListener('message', function (e) {\n    if (!e.data || e.data.type !== 'QZ_CORTEX_PHRASE') return;\n    $('phrase').textContent = '> ' + String(e.data.text || '');\n    log('Frase externa recebida via postMessage');\n  });\n  syncLabels();\n  $('phrase').textContent = '> ' + phrases[0];\n  log('Córtex iniciado · ' + info.title);\n  requestAnimationFrame(loop);\n  setInterval(nextPhrase, 3600);\n})();"
}
