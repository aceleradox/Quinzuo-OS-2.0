{
  "format": "qnz",
  "version": 1,
  "title": "Cortsam Audio Editor",
  "name": "Cortsam Audio Editor",
  "icon": "🎚️",
  "description": "Sintetizador de áudio com osciladores, efeitos, canvas de forma de onda e exportação WAV.",
  "theme": {
    "primary": "#8b5cf6",
    "cyan": "#06b6d4",
    "background": "#0f172a",
    "dockStyle": "glass"
  },
  "window": {
    "width": 900,
    "height": 640,
    "resizable": true
  },
  "html": "\n<div class=\"qz-wrap\">\n  <header class=\"qz-head\">\n    <div class=\"qz-brand\"><span class=\"qz-ico\">🎚️</span><div><b>Cortsam Audio Editor</b><small>sintetizador / editor Web Audio</small></div></div>\n    <span class=\"qz-chip\" id=\"engine\">engine: pronta</span>\n  </header>\n  <div class=\"qz-body\">\n    <section class=\"qz-controls\">\n      <div class=\"qz-group\">\n        <label>Forma de onda</label>\n        <select id=\"waveType\">\n          <option value=\"sine\">Sine</option>\n          <option value=\"square\">Square</option>\n          <option value=\"saw\">Saw</option>\n          <option value=\"triangle\">Triangle</option>\n        </select>\n      </div>\n      <div class=\"qz-group\"><label>Frequência <b id=\"freqVal\">440 Hz</b></label><input id=\"freq\" type=\"range\" min=\"80\" max=\"2000\" value=\"440\" step=\"10\"></div>\n      <div class=\"qz-group\"><label>Duração <b id=\"durVal\">1.50 s</b></label><input id=\"dur\" type=\"range\" min=\"0.2\" max=\"5\" value=\"1.5\" step=\"0.1\"></div>\n      <div class=\"qz-group\"><label>Ganho <b id=\"gainVal\">65%</b></label><input id=\"gain\" type=\"range\" min=\"0\" max=\"1\" value=\"0.65\" step=\"0.01\"></div>\n      <div class=\"qz-sep\">Efeitos</div>\n      <div class=\"qz-group qz-check\"><label><input id=\"lp\" type=\"checkbox\"> Filtro lowpass</label><input id=\"cutoff\" type=\"range\" min=\"200\" max=\"12000\" value=\"3000\" step=\"100\"><small>Corte: <span id=\"cutoffVal\">3000 Hz</span></small></div>\n      <div class=\"qz-group qz-check\"><label><input id=\"delay\" type=\"checkbox\"> Delay / eco</label><input id=\"dtime\" type=\"range\" min=\"0.02\" max=\"0.6\" value=\"0.18\" step=\"0.01\"><input id=\"fb\" type=\"range\" min=\"0\" max=\"0.8\" value=\"0.35\" step=\"0.01\"><small>Tempo <span id=\"dtimeVal\">0.18 s</span> · feedback <span id=\"fbVal\">0.35</span></small></div>\n      <div class=\"qz-group qz-check\"><label><input id=\"noise\" type=\"checkbox\"> Ruído</label><input id=\"amount\" type=\"range\" min=\"0\" max=\"0.8\" value=\"0.15\" step=\"0.01\"><small>Intensidade: <span id=\"amountVal\">0.15</span></small></div>\n    </section>\n    <section class=\"qz-stage\">\n      <div class=\"qz-canvas-box\"><canvas id=\"wave\" width=\"760\" height=\"250\"></canvas><span class=\"qz-canvas-tag\">FORMA DE ONDA · TEMPO REAL</span></div>\n      <div class=\"qz-actions\">\n        <button id=\"btnGen\" class=\"qz-btn qz-btn-primary\">⚙️ Gerar</button>\n        <button id=\"btnPlay\" class=\"qz-btn\">▶ Play</button>\n        <button id=\"btnStop\" class=\"qz-btn\">⏹ Stop</button>\n        <button id=\"btnExport\" class=\"qz-btn qz-btn-cyan\">💾 Exportar WAV</button>\n      </div>\n      <div class=\"qz-log\" id=\"log\">// log interno do Cortsam</div>\n    </section>\n  </div>\n</div>",
  "css": "\n.qz-wrap{font-family:ui-sans-serif,system-ui,sans-serif;color:#e2e8f0}\n.qz-head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 14px;border-bottom:1px solid rgba(139,92,246,.28);background:rgba(139,92,246,.08);border-radius:12px 12px 0 0}\n.qz-brand{display:flex;align-items:center;gap:10px}\n.qz-brand b{display:block;font-size:14px;letter-spacing:.2px}\n.qz-brand small{display:block;color:#94a3b8;font-size:10px}\n.qz-ico{font-size:24px}\n.qz-chip{font-size:10px;color:#22d3ee;border:1px solid rgba(6,182,212,.4);border-radius:99px;padding:3px 9px;background:rgba(6,182,212,.08)}\n.qz-body{display:grid;grid-template-columns:240px 1fr;gap:14px;padding:14px}\n.qz-controls{background:rgba(15,23,42,.7);border:1px solid rgba(148,163,184,.16);border-radius:12px;padding:12px;display:flex;flex-direction:column;gap:11px}\n.qz-group label{display:flex;justify-content:space-between;font-size:11px;color:#cbd5e1;margin-bottom:5px}\n.qz-group label b{color:#22d3ee;font-weight:600}\n.qz-group small{display:block;font-size:10px;color:#64748b;margin-top:4px}\n.qz-group select,.qz-group input[type=range]{width:100%}\n.qz-group select{background:#0f172a;color:#e2e8f0;border:1px solid rgba(139,92,246,.4);border-radius:8px;padding:6px;font-size:12px}\n.qz-group input[type=range]{accent-color:#8b5cf6;height:18px}\n.qz-check label{justify-content:flex-start;gap:7px;cursor:pointer}\n.qz-check input[type=checkbox]{accent-color:#06b6d4}\n.qz-sep{font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:#8b5cf6;border-top:1px solid rgba(148,163,184,.14);padding-top:10px}\n.qz-stage{min-width:0}\n.qz-canvas-box{position:relative;border:1px solid rgba(6,182,212,.25);border-radius:12px;overflow:hidden;background:#080e1d}\n.qz-canvas-box canvas{display:block;width:100%;height:250px}\n.qz-canvas-tag{position:absolute;top:8px;left:10px;font-size:9px;letter-spacing:1.4px;color:rgba(34,211,238,.7)}\n.qz-actions{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}\n.qz-btn{cursor:pointer;border:1px solid rgba(148,163,184,.28);background:#111c33;color:#e2e8f0;padding:8px 13px;border-radius:9px;font-size:12px;font-weight:600;transition:.15s}\n.qz-btn:hover{transform:translateY(-1px);border-color:#8b5cf6}\n.qz-btn-primary{background:linear-gradient(135deg,#7c3aed,#a855f7);border-color:transparent}\n.qz-btn-cyan{background:linear-gradient(135deg,#0891b2,#22d3ee);border-color:transparent;color:#04121b}\n.qz-log{font:11px/1.5 ui-monospace,monospace;color:#94a3b8;background:#080e1d;border:1px solid rgba(148,163,184,.14);border-radius:10px;padding:9px 11px;height:96px;overflow:auto;white-space:pre-wrap}\n@media(max-width:700px){.qz-body{grid-template-columns:1fr}}",
  "js": "\n(function () {\n  var NL = String.fromCharCode(10);\n  var $ = function (id) { return document.getElementById(id); };\n  var canvas = $('wave'), ctx = canvas.getContext('2d');\n  var logEl = $('log'), audioCtx = null, buffer = null, source = null, nodes = [];\n  function log(msg) {\n    logEl.textContent += '[' + new Date().toLocaleTimeString('pt-BR') + '] ' + msg + NL;\n    logEl.scrollTop = logEl.scrollHeight;\n    console.log('[cortsam] ' + msg);\n  }\n  function params() {\n    return {\n      wave: $('waveType').value,\n      freq: parseFloat($('freq').value),\n      dur: parseFloat($('dur').value),\n      gain: parseFloat($('gain').value),\n      lp: $('lp').checked,\n      cutoff: parseFloat($('cutoff').value),\n      delay: $('delay').checked,\n      dtime: parseFloat($('dtime').value),\n      fb: parseFloat($('fb').value),\n      noise: $('noise').checked,\n      amount: parseFloat($('amount').value)\n    };\n  }\n  function sync() {\n    $('freqVal').textContent = $('freq').value + ' Hz';\n    $('durVal').textContent = parseFloat($('dur').value).toFixed(2) + ' s';\n    $('gainVal').textContent = Math.round(parseFloat($('gain').value) * 100) + '%';\n    $('cutoffVal').textContent = $('cutoff').value + ' Hz';\n    $('dtimeVal').textContent = parseFloat($('dtime').value).toFixed(2) + ' s';\n    $('fbVal').textContent = $('fb').value;\n    $('amountVal').textContent = $('amount').value;\n  }\n  function synthesize(p, rate) {\n    var n = Math.max(1, Math.floor(rate * p.dur));\n    var data = new Float32Array(n), phase = 0, filtered = 0;\n    var a = 1 - Math.exp(-2 * Math.PI * p.cutoff / rate);\n    var delaySamples = Math.max(1, Math.floor(p.dtime * rate));\n    for (var i = 0; i < n; i++) {\n      phase = (phase + p.freq / rate) % 1;\n      var s;\n      if (p.wave === 'square') s = phase < 0.5 ? 1 : -1;\n      else if (p.wave === 'saw') s = 2 * phase - 1;\n      else if (p.wave === 'triangle') s = 1 - 4 * Math.abs(phase - 0.5);\n      else s = Math.sin(2 * Math.PI * phase);\n      var edge = rate * 0.008;\n      var env = Math.min(1, i / edge, (n - i) / edge);\n      s *= env;\n      if (p.noise) s = s * (1 - p.amount) + (Math.random() * 2 - 1) * p.amount;\n      if (p.lp) { filtered += a * (s - filtered); s = filtered; }\n      if (p.delay && i > delaySamples) s += data[i - delaySamples] * p.fb;\n      data[i] = Math.max(-1, Math.min(1, s * p.gain));\n    }\n    return data;\n  }\n  function draw(samples) {\n    var w = canvas.width, h = canvas.height;\n    ctx.clearRect(0, 0, w, h);\n    ctx.fillStyle = '#080e1d'; ctx.fillRect(0, 0, w, h);\n    ctx.lineWidth = 1; ctx.strokeStyle = 'rgba(6,182,212,0.10)';\n    for (var gx = 0; gx < w; gx += 38) { ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, h); ctx.stroke(); }\n    for (var gy = 0; gy < h; gy += 32) { ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(w, gy); ctx.stroke(); }\n    ctx.strokeStyle = 'rgba(148,163,184,0.35)'; ctx.beginPath(); ctx.moveTo(0, h / 2); ctx.lineTo(w, h / 2); ctx.stroke();\n    if (!samples || !samples.length) return;\n    var grad = ctx.createLinearGradient(0, 0, w, 0);\n    grad.addColorStop(0, '#a855f7'); grad.addColorStop(0.5, '#8b5cf6'); grad.addColorStop(1, '#22d3ee');\n    ctx.strokeStyle = grad; ctx.lineWidth = 2; ctx.beginPath();\n    var step = Math.max(1, Math.floor(samples.length / w));\n    for (var i = 0; i < samples.length; i += step) {\n      var px = i / samples.length * w, py = h / 2 - samples[i] * h * 0.44;\n      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);\n    }\n    ctx.stroke();\n  }\n  function ensureCtx() {\n    if (!audioCtx) {\n      var AC = window.AudioContext || window.webkitAudioContext;\n      if (!AC) { log('Web Audio indisponível neste navegador'); return null; }\n      audioCtx = new AC();\n      $('engine').textContent = 'engine: ' + Math.round(audioCtx.sampleRate / 1000) + ' kHz';\n      log('AudioContext iniciado · ' + audioCtx.sampleRate + ' Hz');\n    }\n    if (audioCtx.state === 'suspended') audioCtx.resume();\n    return audioCtx;\n  }\n  function generate(quiet) {\n    var ac = ensureCtx();\n    if (!ac) return;\n    var p = params(), samples = synthesize(p, ac.sampleRate);\n    buffer = ac.createBuffer(1, samples.length, ac.sampleRate);\n    if (buffer.copyToChannel) buffer.copyToChannel(samples, 0);\n    else buffer.getChannelData(0).set(samples);\n    draw(samples);\n    if (!quiet) log('Gerado ' + p.wave + ' · ' + p.freq + ' Hz · ' + p.dur.toFixed(2) + ' s · ' + samples.length + ' amostras');\n  }\n  function stop() {\n    if (!source) return;\n    try { source.stop(); } catch (e) {}\n    source.disconnect(); source = null;\n    nodes.forEach(function (n) { try { n.disconnect(); } catch (e) {} });\n    nodes = [];\n    log('Stop');\n  }\n  function play() {\n    var ac = ensureCtx();\n    if (!ac) return;\n    if (!buffer) generate(true);\n    stop();\n    var src = ac.createBufferSource(), g = ac.createGain();\n    src.buffer = buffer; g.gain.value = 0.9;\n    src.connect(g); g.connect(ac.destination);\n    src.onended = function () { if (source === src) { source = null; log('Reprodução concluída'); } };\n    src.start(0);\n    source = src; nodes = [g];\n    log('Play ▶ ' + params().wave + ' / ' + params().freq + ' Hz');\n  }\n  function wavDataUrl(channel, rate) {\n    var n = channel.length, buf = new ArrayBuffer(44 + n * 2), v = new DataView(buf);\n    function put(off, text) { for (var k = 0; k < text.length; k++) v.setUint8(off + k, text.charCodeAt(k)); }\n    put(0, 'RIFF'); v.setUint32(4, 36 + n * 2, true); put(8, 'WAVE'); put(12, 'fmt ');\n    v.setUint32(16, 16, true); v.setUint16(20, 1, true); v.setUint16(22, 1, true);\n    v.setUint32(24, rate, true); v.setUint32(28, rate * 2, true);\n    v.setUint16(32, 2, true); v.setUint16(34, 16, true);\n    put(36, 'data'); v.setUint32(40, n * 2, true);\n    for (var i = 0; i < n; i++) {\n      var s = Math.max(-1, Math.min(1, channel[i]));\n      v.setInt16(44 + i * 2, s < 0 ? s * 32768 : s * 32767, true);\n    }\n    var bytes = new Uint8Array(buf), bin = '';\n    for (var j = 0; j < bytes.length; j += 8192) bin += String.fromCharCode.apply(null, bytes.subarray(j, j + 8192));\n    return 'data:audio/wav;base64,' + btoa(bin);\n  }\n  function exportWav() {\n    var ac = ensureCtx();\n    if (!ac) return;\n    if (!buffer) generate(true);\n    var dataUrl = wavDataUrl(buffer.getChannelData(0), buffer.sampleRate);\n    parent.postMessage({ type: 'QZ_SAVE_FILE', name: 'cortsam.wav', mimeType: 'audio/wav', fileType: 'audio/wav', content: dataUrl }, '*');\n    log('Exportado cortsam.wav via QZ_SAVE_FILE · ' + Math.round(dataUrl.length / 1024) + ' KB');\n  }\n  ['freq', 'dur', 'gain', 'cutoff', 'dtime', 'fb', 'amount'].forEach(function (id) {\n    $(id).addEventListener('input', function () { sync(); draw(synthesize(params(), 44100)); });\n  });\n  $('waveType').addEventListener('change', function () { draw(synthesize(params(), 44100)); log('Forma de onda: ' + params().wave); });\n  ['lp', 'delay', 'noise'].forEach(function (id) {\n    $(id).addEventListener('change', function () { draw(synthesize(params(), 44100)); log(id + ' ' + ($(id).checked ? 'on' : 'off')); });\n  });\n  $('btnGen').onclick = function () { generate(false); };\n  $('btnPlay').onclick = play;\n  $('btnStop').onclick = stop;\n  $('btnExport').onclick = exportWav;\n  sync();\n  draw(synthesize(params(), 44100));\n  log('Cortsam pronto · use Gerar, Play ou Exportar WAV');\n})();"
}
