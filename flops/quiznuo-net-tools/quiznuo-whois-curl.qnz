{
  "format": "qnz",
  "version": 1,
  "title": "Quiznuo Net Tools · CURL/WHOIS",
  "name": "Quiznuo Net Tools · CURL/WHOIS",
  "icon": "🌐",
  "description": "Interface de rede com CURL e WHOIS via ponte postMessage, exibindo headers e corpo.",
  "theme": {
    "primary": "#8b5cf6",
    "cyan": "#06b6d4",
    "background": "#0f172a",
    "dockStyle": "glass"
  },
  "window": {
    "width": 880,
    "height": 600,
    "resizable": true
  },
  "html": "\n<div class=\"qz-wrap\">\n  <header class=\"qz-head\">\n    <div class=\"qz-brand\"><span class=\"qz-ico\">🌐</span><div><b>Quiznuo Net Tools</b><small>CURL / WHOIS via ponte do runner</small></div></div>\n    <span class=\"qz-chip\" id=\"bridgeState\">ponte: aguardando</span>\n  </header>\n  <div class=\"qz-main\">\n    <div class=\"qz-bar\">\n      <input id=\"qzInput\" type=\"text\" value=\"https://example.com\" placeholder=\"URL ou domínio\" spellcheck=\"false\">\n      <button id=\"qzCurl\" class=\"qz-btn qz-btn-primary\">⚡ CURL</button>\n      <button id=\"qzWhois\" class=\"qz-btn qz-btn-cyan\">🔎 WHOIS</button>\n      <button id=\"qzCopy\" class=\"qz-btn\">⧉ Copiar</button>\n      <button id=\"qzDownload\" class=\"qz-btn\">💾 Baixar</button>\n    </div>\n    <div id=\"qzStatus\" class=\"qz-status\">Pronto. Digite uma URL ou domínio e escolha CURL ou WHOIS.</div>\n    <div class=\"qz-panes\">\n      <section><div class=\"qz-pane-title\">HEADERS</div><pre id=\"qzHeaders\">// aguardando resposta...</pre></section>\n      <section><div class=\"qz-pane-title\">CORPO / RESPOSTA</div><pre id=\"qzBody\">// aguardando resposta...</pre></section>\n    </div>\n    <div class=\"qz-log\" id=\"qzLog\">// log de requisições</div>\n  </div>\n</div>",
  "css": "\n.qz-wrap{font-family:ui-sans-serif,system-ui,sans-serif;color:#e2e8f0}\n.qz-head{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;border-bottom:1px solid rgba(6,182,212,.26);background:rgba(6,182,212,.07);border-radius:12px 12px 0 0}\n.qz-brand{display:flex;align-items:center;gap:10px}\n.qz-brand b{font-size:14px;display:block}.qz-brand small{font-size:10px;color:#94a3b8;display:block}\n.qz-ico{font-size:24px}.qz-chip{font-size:10px;color:#a78bfa;border:1px solid rgba(139,92,246,.4);border-radius:99px;padding:3px 9px}\n.qz-chip.live{color:#22d3ee;border-color:rgba(6,182,212,.55)}\n.qz-main{padding:13px;display:flex;flex-direction:column;gap:10px}\n.qz-bar{display:flex;flex-wrap:wrap;gap:8px}\n.qz-bar input{flex:1;min-width:220px;background:#080e1d;color:#e2e8f0;border:1px solid rgba(139,92,246,.42);border-radius:9px;padding:9px 11px;font:12px ui-monospace,monospace;outline:none}\n.qz-bar input:focus{border-color:#22d3ee;box-shadow:0 0 0 2px rgba(6,182,212,.12)}\n.qz-btn{cursor:pointer;border:1px solid rgba(148,163,184,.3);background:#111c33;color:#e2e8f0;padding:9px 12px;border-radius:9px;font-size:12px;font-weight:600}\n.qz-btn:hover{border-color:#8b5cf6;transform:translateY(-1px)}\n.qz-btn-primary{background:linear-gradient(135deg,#7c3aed,#a855f7);border-color:transparent}\n.qz-btn-cyan{background:linear-gradient(135deg,#0891b2,#22d3ee);border-color:transparent;color:#04121b}\n.qz-status{font-size:11px;color:#cbd5e1;background:rgba(139,92,246,.1);border:1px solid rgba(139,92,246,.22);padding:8px 11px;border-radius:9px;min-height:30px}\n.qz-status.err{color:#fca5a5;border-color:rgba(248,113,113,.4);background:rgba(248,113,113,.08)}\n.qz-status.ok{color:#67e8f9;border-color:rgba(6,182,212,.4);background:rgba(6,182,212,.08)}\n.qz-panes{display:grid;grid-template-columns:1fr 1fr;gap:10px;flex:1;min-height:0}\n.qz-panes section{min-width:0;display:flex;flex-direction:column}\n.qz-pane-title{font-size:10px;letter-spacing:1.4px;color:#a78bfa;padding:5px 2px}\n.qz-panes pre{flex:1;min-height:200px;margin:0;background:#080e1d;border:1px solid rgba(148,163,184,.16);border-radius:9px;padding:10px;color:#cbd5e1;font:11px/1.55 ui-monospace,monospace;overflow:auto;white-space:pre-wrap;word-break:break-word}\n.qz-log{font:11px/1.5 ui-monospace,monospace;color:#94a3b8;background:#080e1d;border:1px solid rgba(148,163,184,.14);border-radius:9px;padding:8px 10px;height:74px;overflow:auto;white-space:pre-wrap}\n@media(max-width:700px){.qz-panes{grid-template-columns:1fr}}",
  "js": "\n(function () {\n  var NL = String.fromCharCode(10);\n  var $ = function (id) { return document.getElementById(id); };\n  var input = $('qzInput'), statusEl = $('qzStatus'), headersEl = $('qzHeaders'), bodyEl = $('qzBody'), logEl = $('qzLog');\n  var pending = {}, seq = 0, lastText = '';\n  function log(msg) {\n    logEl.textContent += '[' + new Date().toLocaleTimeString('pt-BR') + '] ' + msg + NL;\n    logEl.scrollTop = logEl.scrollHeight;\n    console.log('[quiznuo-net] ' + msg);\n  }\n  function status(text, kind) {\n    statusEl.textContent = text;\n    statusEl.className = 'qz-status' + (kind ? ' ' + kind : '');\n  }\n  function request(kind) {\n    var value = input.value.trim();\n    if (!value) { status('Informe uma URL ou domínio.', 'err'); return; }\n    var id = 'qznet-' + Date.now() + '-' + (++seq);\n    pending[id] = kind;\n    $('bridgeState').textContent = 'ponte: requisição enviada';\n    $('bridgeState').className = 'qz-chip live';\n    status(kind.toUpperCase() + ' · aguardando resposta (id ' + id + ')...');\n    headersEl.textContent = '// ' + kind.toUpperCase() + ' em andamento...';\n    bodyEl.textContent = '// aguardando QZ_NET_RESPONSE';\n    parent.postMessage({ type: 'QZ_NET_REQUEST', id: id, kind: kind, value: value }, '*');\n    log(kind.toUpperCase() + ' → ' + value + ' [id=' + id + ']');\n    setTimeout(function () {\n      if (pending[id]) {\n        delete pending[id];\n        status('Timeout: a ponte não respondeu (id ' + id + ').', 'err');\n        log('TIMEOUT ' + kind + ' ' + id);\n      }\n    }, 30000);\n  }\n  function stringify(value) {\n    if (value === null || value === undefined) return '';\n    return typeof value === 'string' ? value : JSON.stringify(value, null, 2);\n  }\n  window.addEventListener('message', function (e) {\n    var d = e.data;\n    if (!d || d.type !== 'QZ_NET_RESPONSE') return;\n    if (!pending[d.id]) { log('Resposta ignorada, id desconhecido: ' + d.id); return; }\n    var kind = pending[d.id]; delete pending[d.id];\n    var raw = d.data, head = '', body = raw;\n    if (raw && typeof raw === 'object') {\n      if (raw.headers) head = stringify(raw.headers);\n      if (raw.body !== undefined) body = raw.body;\n      else if (raw.data !== undefined) body = raw.data;\n      else if (raw.content !== undefined) body = raw.content;\n      else body = raw;\n    }\n    var text = stringify(body);\n    if (!d.ok && !text) text = String(d.error || 'Erro desconhecido na ponte.');\n    headersEl.textContent = head || '// sem headers informados';\n    bodyEl.textContent = text || '(resposta vazia)';\n    lastText = (head ? 'HEADERS' + NL + head + NL + NL : '') + 'BODY' + NL + text;\n    status((d.ok ? '✔ ' : '✖ ') + kind.toUpperCase() + ' concluído · ' + text.length + ' caracteres', d.ok ? 'ok' : 'err');\n    $('bridgeState').textContent = 'ponte: online';\n    log((d.ok ? 'OK' : 'ERRO') + ' ' + kind + ' ' + d.id + ' · ' + text.length + ' chars');\n  });\n  function fallbackCopy(text) {\n    var ta = document.createElement('textarea');\n    ta.value = text;\n    ta.style.position = 'fixed'; ta.style.opacity = '0';\n    document.body.appendChild(ta); ta.select();\n    var ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }\n    document.body.removeChild(ta);\n    return ok;\n  }\n  $('qzCurl').onclick = function () { request('curl'); };\n  $('qzWhois').onclick = function () { request('whois'); };\n  input.addEventListener('keydown', function (e) { if (e.key === 'Enter') request('curl'); });\n  $('qzCopy').onclick = function () {\n    var text = lastText || bodyEl.textContent;\n    if (navigator.clipboard && navigator.clipboard.writeText) {\n      navigator.clipboard.writeText(text).then(function () { status('Copiado para a área de transferência.', 'ok'); })\n        .catch(function () { status(fallbackCopy(text) ? 'Copiado (fallback).' : 'Não foi possível copiar.', 'ok'); });\n    } else status(fallbackCopy(text) ? 'Copiado (fallback).' : 'Não foi possível copiar.', 'ok');\n    log('Copiar: ' + text.length + ' chars');\n  };\n  $('qzDownload').onclick = function () {\n    var blob = new Blob([lastText || bodyEl.textContent], { type: 'text/plain;charset=utf-8' });\n    var url = URL.createObjectURL(blob), a = document.createElement('a');\n    a.href = url; a.download = 'quiznuo-response.txt';\n    document.body.appendChild(a);\n    try { a.click(); status('Download iniciado: quiznuo-response.txt', 'ok'); log('Download iniciado'); }\n    catch (err) { status('Download bloqueado pelo sandbox: ' + err.message, 'err'); }\n    document.body.removeChild(a);\n    setTimeout(function () { URL.revokeObjectURL(url); }, 2000);\n  };\n  log('Quiznuo Net Tools pronto · aguardando QZ_NET_REQUEST/QZ_NET_RESPONSE');\n})();"
}
