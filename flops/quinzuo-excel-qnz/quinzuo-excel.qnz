{
  "format": "qnz",
  "version": 1,
  "title": "Quinzuo Excel — Planilha QNZ",
  "name": "Quinzuo Excel — Planilha QNZ",
  "icon": "📊",
  "description": "Planilha 10x8 editável com barra de fórmula, SUM/cálculo de células, salvamento local e exportação CSV.",
  "theme": {
    "primary": "#8b5cf6",
    "cyan": "#06b6d4",
    "background": "#0f172a",
    "dockStyle": "glass"
  },
  "window": {
    "width": 880,
    "height": 620,
    "resizable": true
  },
  "html": "\n<div class=\"qz-wrap\">\n  <header class=\"qz-head\"><div class=\"qz-brand\"><span class=\"qz-ico\">📊</span><div><b>Quinzuo Excel · Planilha QNZ</b><small>10 × 8 · fórmulas · localStorage · CSV</small></div></div><span class=\"qz-chip\">.QNZ SHEET</span></header>\n  <div class=\"qz-bar\">\n    <input id=\"cellRef\" class=\"qz-ref\" value=\"A1\" readonly title=\"Célula atual\">\n    <span class=\"qz-fx\">fx</span>\n    <input id=\"formula\" class=\"qz-formula\" placeholder=\"Valor ou fórmula: =SUM(A1:A3) / =A1+B1\" spellcheck=\"false\">\n  </div>\n  <div class=\"qz-tools\">\n    <button id=\"save\" class=\"qz-btn qz-btn-primary\">💾 Salvar</button>\n    <button id=\"load\" class=\"qz-btn\">📂 Carregar</button>\n    <button id=\"clear\" class=\"qz-btn\">🧹 Limpar</button>\n    <button id=\"csv\" class=\"qz-btn qz-btn-cyan\">⬇ Exportar CSV</button>\n    <span id=\"status\" class=\"qz-status\">A1 · (vazio)</span>\n  </div>\n  <div class=\"qz-sheet-box\"><div id=\"grid\" class=\"qz-sheet\"></div></div>\n  <div class=\"qz-log\" id=\"log\">// log da planilha</div>\n</div>",
  "css": "\n.qz-wrap{font-family:ui-sans-serif,system-ui,sans-serif;color:#e2e8f0}\n.qz-head{display:flex;justify-content:space-between;align-items:center;padding:9px 13px;border-bottom:1px solid rgba(139,92,246,.3);background:rgba(139,92,246,.09);border-radius:12px 12px 0 0}\n.qz-brand{display:flex;align-items:center;gap:9px}.qz-brand b{font-size:14px}.qz-brand small{font-size:10px;color:#94a3b8;display:block}\n.qz-ico{font-size:23px}.qz-chip{font-size:10px;color:#22d3ee;border:1px solid rgba(6,182,212,.4);border-radius:99px;padding:3px 9px}\n.qz-bar{display:flex;align-items:center;gap:8px;padding:11px 13px 0}\n.qz-ref{width:62px;text-align:center;background:#080e1d;color:#a78bfa;border:1px solid rgba(139,92,246,.4);border-radius:8px;padding:7px;font:12px ui-monospace,monospace}\n.qz-fx{font:italic 13px Georgia,serif;color:#22d3ee}\n.qz-formula{flex:1;background:#080e1d;color:#e2e8f0;border:1px solid rgba(148,163,184,.22);border-radius:8px;padding:7px 10px;font:12px ui-monospace,monospace;outline:none}\n.qz-formula:focus{border-color:#8b5cf6}\n.qz-tools{display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding:10px 13px}\n.qz-btn{cursor:pointer;border:1px solid rgba(148,163,184,.3);background:#111c33;color:#e2e8f0;padding:7px 11px;border-radius:8px;font-size:11px;font-weight:600}\n.qz-btn:hover{border-color:#8b5cf6;transform:translateY(-1px)}\n.qz-btn-primary{background:linear-gradient(135deg,#7c3aed,#a855f7);border-color:transparent}\n.qz-btn-cyan{background:linear-gradient(135deg,#0891b2,#22d3ee);border-color:transparent;color:#04121b}\n.qz-status{font-size:10px;color:#a78bfa;margin-left:auto}\n.qz-sheet-box{padding:0 13px;overflow:auto;flex:1}\n.qz-sheet{border-collapse:collapse;min-width:640px;font:12px ui-monospace,monospace}\n.qz-sheet th,.qz-sheet td{border:1px solid rgba(148,163,184,.16);padding:0}\n.qz-sheet thead th{background:rgba(139,92,246,.18);color:#c4b5fd;font-size:11px;padding:5px;min-width:76px}\n.qz-sheet tbody th{background:rgba(15,23,42,.8);color:#64748b;font-weight:400;width:34px;text-align:center}\n.qz-sheet input{width:76px;height:26px;background:#080e1d;color:#e2e8f0;border:0;outline:0;padding:0 5px;font:12px ui-monospace,monospace}\n.qz-sheet input:focus{box-shadow:inset 0 0 0 2px #8b5cf6;background:#0d1730}\n.qz-log{font:10px/1.5 ui-monospace,monospace;color:#64748b;margin:10px 13px 11px;border-top:1px solid rgba(148,163,184,.12);padding-top:7px;max-height:52px;overflow:auto;white-space:pre-wrap}",
  "js": "\n(function () {\n  var NL = String.fromCharCode(10);\n  var $ = function (id) { return document.getElementById(id); };\n  var ROWS = 10, COLS = 8, KEY = 'qz_excel_v1';\n  var cells = {}, inputs = {}, current = 'A1';\n  function log(m) { $('log').textContent += '[' + new Date().toLocaleTimeString('pt-BR') + '] ' + m + NL; console.log('[quinzuo-excel] ' + m); }\n  function colName(i) { return String.fromCharCode(65 + i); }\n  function refOf(r, c) { return colName(c) + (r + 1); }\n  function isLetter(ch) { var n = String(ch).toUpperCase().charCodeAt(0); return n >= 65 && n <= 90; }\n  function isDigit(ch) { var n = String(ch).charCodeAt(0); return n >= 48 && n <= 57; }\n  function parseRef(ref) {\n    if (!ref || ref.length < 2 || ref.length > 3) return null;\n    var col = ref.charCodeAt(0) - 65, num = parseInt(ref.slice(1), 10);\n    if (col < 0 || col >= COLS || !num || num < 1 || num > ROWS) return null;\n    if (String(num) !== ref.slice(1)) return null;\n    return { c: col, r: num - 1 };\n  }\n  function calc(text) {\n    var s = String(text).replace(/ /g, ''), i = 0;\n    function factor() {\n      if (s.charAt(i) === '+') { i++; return factor(); }\n      if (s.charAt(i) === '-') { i++; return -factor(); }\n      if (s.charAt(i) === '(') { i++; var v = sum(); if (s.charAt(i) === ')') i++; return v; }\n      var st = i;\n      while (i < s.length && isDigit(s.charAt(i)) || (i < s.length && s.charAt(i) === '.')) i++;\n      if (st === i) throw new Error('numero esperado');\n      var n = parseFloat(s.slice(st, i));\n      if (isNaN(n)) throw new Error('numero invalido');\n      return n;\n    }\n    function product() {\n      var v = factor();\n      while (s.charAt(i) === '*' || s.charAt(i) === '/') {\n        var op = s.charAt(i++), r = factor();\n        if (op === '*') v *= r;\n        else { if (r === 0) throw new Error('divisao por zero'); v /= r; }\n      }\n      return v;\n    }\n    function sum() {\n      var v = product();\n      while (s.charAt(i) === '+' || s.charAt(i) === '-') {\n        var op = s.charAt(i++), r = product();\n        v = op === '+' ? v + r : v - r;\n      }\n      return v;\n    }\n    return sum();\n  }\n  function cellValue(ref, stack) {\n    if (stack.indexOf(ref) >= 0) return 0;\n    var raw = cells[ref] || '';\n    if (raw.charAt(0) === '=') return evalFormula(raw.slice(1), stack.concat([ref]));\n    var n = parseFloat(String(raw).split(',').join('.'));\n    return isNaN(n) ? 0 : n;\n  }\n  function sumRange(a, b, stack) {\n    var p1 = parseRef(String(a).trim().toUpperCase()), p2 = parseRef(String(b).trim().toUpperCase());\n    if (!p1 || !p2) return 0;\n    var total = 0;\n    for (var r = Math.min(p1.r, p2.r); r <= Math.max(p1.r, p2.r); r++)\n      for (var c = Math.min(p1.c, p2.c); c <= Math.max(p1.c, p2.c); c++)\n        total += cellValue(refOf(r, c), stack);\n    return total;\n  }\n  function evalFormula(expr, stack) {\n    var s = String(expr), guard = 0;\n    while (s.toUpperCase().indexOf('SUM(') >= 0 && guard++ < 30) {\n      var up = s.toUpperCase(), start = up.indexOf('SUM('), open = start + 3;\n      var depth = 1, end = open + 1;\n      while (end < s.length && depth > 0) {\n        var ch = s.charAt(end);\n        if (ch === '(') depth++; else if (ch === ')') depth--;\n        end++;\n      }\n      if (depth > 0) break;\n      var inside = s.slice(open + 1, end - 1), total = 0;\n      inside.split(',').forEach(function (part) {\n        var p = String(part).trim().toUpperCase();\n        if (p.indexOf(':') >= 0) {\n          var segs = p.split(':');\n          total += sumRange(segs[0], segs[1], stack);\n        } else total += cellValue(p, stack);\n      });\n      s = s.slice(0, start) + '(' + total + ')' + s.slice(end);\n    }\n    var out = '', i = 0;\n    while (i < s.length) {\n      var c = s.charAt(i);\n      if (isLetter(c)) {\n        var j = i;\n        while (j < s.length && (isLetter(s.charAt(j)) || isDigit(s.charAt(j)))) j++;\n        var ref = s.slice(i, j).toUpperCase();\n        if (parseRef(ref)) { out += '(' + cellValue(ref, stack) + ')'; i = j; continue; }\n      }\n      out += c; i++;\n    }\n    try { var v = calc(out); return isFinite(v) ? v : 0; } catch (e) { return 0; }\n  }\n  function fmt(v) { return isFinite(v) ? String(Math.round(v * 1000) / 1000) : '#ERRO'; }\n  function shown(ref) {\n    var raw = cells[ref] || '';\n    return raw.charAt(0) === '=' ? fmt(cellValue(ref, [])) : raw;\n  }\n  function paintGrid() {\n    for (var r = 0; r < ROWS; r++)\n      for (var c = 0; c < COLS; c++) {\n        var ref = refOf(r, c), el = inputs[ref];\n        if (el && document.activeElement !== el) el.value = shown(ref);\n      }\n  }\n  function updateBar() {\n    $('cellRef').value = current;\n    $('formula').value = cells[current] || '';\n    $('status').textContent = current + ' · ' + (cells[current] || '(vazio)');\n  }\n  function build() {\n    var table = document.createElement('table'), thead = document.createElement('thead'), hr = document.createElement('tr');\n    var corner = document.createElement('th'); corner.textContent = ''; hr.appendChild(corner);\n    for (var c = 0; c < COLS; c++) { var th = document.createElement('th'); th.textContent = colName(c); hr.appendChild(th); }\n    thead.appendChild(hr); table.appendChild(thead);\n    var tbody = document.createElement('tbody');\n    for (var r = 0; r < ROWS; r++) {\n      var row = document.createElement('tr'), rh = document.createElement('th');\n      rh.textContent = String(r + 1); row.appendChild(rh);\n      for (var cc = 0; cc < COLS; cc++) {\n        var td = document.createElement('td'), inp = document.createElement('input'), ref = refOf(r, cc);\n        inp.setAttribute('data-ref', ref);\n        inp.onfocus = function () { current = this.getAttribute('data-ref'); updateBar(); };\n        inp.oninput = function () { cells[this.getAttribute('data-ref')] = this.value; paintGrid(); $('status').textContent = current + ' · editando'; };\n        inp.onkeydown = function (e) {\n          if (e.key === 'Enter') {\n            e.preventDefault();\n            var p = parseRef(current);\n            if (p && p.r < ROWS - 1) inputs[refOf(p.r + 1, p.c)].focus();\n          }\n        };\n        td.appendChild(inp); row.appendChild(td); inputs[ref] = inp;\n      }\n      tbody.appendChild(row);\n    }\n    table.appendChild(tbody);\n    $('grid').innerHTML = ''; $('grid').appendChild(table);\n  }\n  function save() {\n    try { localStorage.setItem(KEY, JSON.stringify(cells)); log('Planilha salva no localStorage'); return true; }\n    catch (e) { log('localStorage indisponivel: ' + e.message); return false; }\n  }\n  function load() {\n    try {\n      var raw = localStorage.getItem(KEY);\n      if (!raw) { log('Nenhuma planilha salva'); return; }\n      var obj = JSON.parse(raw);\n      cells = obj && typeof obj === 'object' ? obj : {};\n      paintGrid(); updateBar(); log('Planilha carregada do localStorage');\n    } catch (e) { log('Erro ao carregar: ' + e.message); }\n  }\n  function csvCell(v) { return '\"' + String(v).split('\"').join('\"\"') + '\"'; }\n  function exportCsv() {\n    var header = [''], lines = [];\n    for (var c = 0; c < COLS; c++) header.push(colName(c));\n    lines.push(header.map(csvCell).join(','));\n    for (var r = 0; r < ROWS; r++) {\n      var row = [String(r + 1)];\n      for (var cc = 0; cc < COLS; cc++) row.push(shown(refOf(r, cc)));\n      lines.push(row.map(csvCell).join(','));\n    }\n    var csv = lines.join(NL);\n    parent.postMessage({ type: 'QZ_SAVE_FILE', name: 'planilha.csv', mimeType: 'text/csv', fileType: 'text/csv', content: csv }, '*');\n    log('CSV exportado via QZ_SAVE_FILE · ' + csv.length + ' caracteres');\n  }\n  $('formula').addEventListener('input', function () {\n    cells[current] = this.value; paintGrid();\n    $('status').textContent = current + ' · ' + (this.value || '(vazio)');\n  });\n  $('save').onclick = save;\n  $('load').onclick = load;\n  $('clear').onclick = function () {\n    if (!window.confirm('Limpar todas as celulas?')) return;\n    cells = {}; document.activeElement.blur(); paintGrid(); updateBar(); log('Planilha limpa');\n  };\n  $('csv').onclick = exportCsv;\n  build(); updateBar();\n  cells.A1 = '10'; cells.A2 = '20'; cells.A3 = '=A1+A2'; cells.B1 = '=SUM(A1:A3)';\n  paintGrid();\n  log('Quinzuo Excel pronto · experimente =SUM(A1:A3) ou =A1+B1');\n})();"
}
